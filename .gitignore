# 依赖与构建产物
node_modules/
dist/
.astro/

# 浏览器审计临时资料
.chrome-audit-*/

# 构建日志
*.log

# 临时探针与草稿文件
*_probe*
*_probe_tmp*
*_tmp.*

# 备份文件（重写/迁移数据前留的旧版本，不入库）
*.bak

# 受版权保护的第三方数据（曲目清单、定数、Jubility、充能、考据、曲绘）
# 仅保留代码与可公开的元数据结构。这些数据存放在私有仓库
# SnowindMe/jubeat-wiki-data，构建前由 scripts/fetch-data.mjs 拉取。
data/songs.json
data/difficulty-index.json
data/jubility.json
data/unlock.json
data/data-meta.json
data/data-conflicts.json
data/audit-report.md
data/_audit/
public/jackets/

# 谱面 memo 文本（源自 SONICY / COSMOS memo 两个 atwiki 站点，第三方受版权保护数据）
# 由 scripts/fetch-memo.mjs 本机抓取生成，构建前经 fetch-data.mjs 从私有仓库同步
data/memo/
data/_memo_backup/

# 谱面预览器素材（.mcz 解包产物：音频、曲绘为第三方受版权保护数据）
# 由 scripts/fetch-mcz.mjs 生成到 data/chart-assets/，仅供本地对照，不进 public 也不入库
data/chart/
data/chart-assets/
data/memo-hold/

# 抓取用的 Chrome 临时 profile
.memo-chrome-profile/
.hold-probe-profile/

# 数据拉取与发布用暂存目录
.data-fetch/
_data-repo/

# 平台本地状态
.wrangler/
.vercel/
