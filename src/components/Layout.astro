---
import '../styles/tokens.css';
interface Props { title: string; description: string; section?: 'songs' | 'data' | 'catalogue' | 'about'; }
const { title, description, section } = Astro.props;
const nav = [{ key:'songs',label:'曲目库',items:[['曲目库','/songs/']] },{key:'data',label:'数据',items:[['Jubility 理论值','/jubility/'],['隐藏曲充能','/unlock/']]},{key:'catalogue',label:'图鉴',items:[['版本沿革','/versions/'],['更新情报','/updates/'],['玩法判定','/gameplay/'],['段位图鉴','/dans/']]},{key:'about',label:'关于',items:[['新手上路','/guide/'],['关于本站','/about/']]}] as const;
const canonical = new URL(Astro.url.pathname, 'https://byd-ub.top').href;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} · jubeat 音乐魔方 WIKI</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/></head><body><div class="w-ambient" aria-hidden="true"><div class="w-ambient-rail"></div></div><a class="w-skip-link" href="#content">跳到正文</a><header class="site-header"><div class="w-shell site-header__inner"><a class="brand" href="/" aria-label="jubeat 音乐魔方 WIKI 首页"><span class="w-brand-logo-frame"><img class="w-brand-logo" src="/brand/jubeat-music-cube-logo.webp" alt="jubeat 音乐魔方"/></span><b>WIKI</b></a><button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav">导航菜单</button><nav id="main-nav" aria-label="主导航" class="global-nav">{nav.map(group => <details class:list={["nav-group",{active:section===group.key}]}><summary>{group.label}</summary><div class="nav-menu">{group.items.map(([label,href])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}>{label}</a>)}</div></details>)}</nav></div></header><main id="content" class="w-shell"><slot /></main><footer class="site-footer w-shell">非官方中文资料站，与 KONAMI / WAHLAP 无关。数据缺口如实标记，不以推测补全。</footer><script>document.documentElement.classList.add('js');const button=document.querySelector('.nav-toggle'),nav=document.querySelector('#main-nav'); if(button&&nav){const close=()=>{nav.classList.remove('is-open');button.setAttribute('aria-expanded','false')};button.addEventListener('click',()=>{const open=nav.classList.toggle('is-open');button.setAttribute('aria-expanded',String(open));if(open)nav.querySelector('summary')?.focus()});document.addEventListener('keydown',e=>{if(e.key==='Escape'){close();button.focus()}});nav.addEventListener('click',e=>{if((e.target as Element).closest('a'))close()})}</script></body></html>
<style>.site-header{position:sticky;top:0;z-index:10;border-bottom:1px solid var(--w-seam);background:var(--w-panel-glass);backdrop-filter:blur(10px)}.site-header__inner{min-height:var(--w-nav-h);display:flex;align-items:center;gap:var(--w-s-5)}.brand{display:flex;align-items:center;gap:var(--w-s-2);color:var(--w-ink);text-decoration:none}.brand b{font-family:var(--w-font-data);font-size:var(--w-fs-sm)}.global-nav{display:flex;align-items:stretch;gap:var(--w-s-1);margin-left:auto}.nav-group{position:relative}.nav-group summary{display:flex;align-items:center;min-height:var(--w-tap);padding:0 var(--w-s-3);cursor:pointer;font-weight:700;list-style:none}.nav-group summary::-webkit-details-marker{display:none}.nav-group summary::after{content:'⌄';margin-left:var(--w-s-1)}.nav-group.active summary{border-bottom:2px solid var(--w-hit);color:var(--w-hit-deep)}.nav-menu{position:absolute;right:0;min-width:170px;padding:var(--w-s-2);border:1px solid var(--w-seam);border-radius:var(--w-r-sm);background:var(--w-panel);box-shadow:var(--w-shadow-lift)}.nav-menu a{display:block;padding:var(--w-s-2);color:var(--w-ink);text-decoration:none}.nav-menu a[aria-current=page]{background:var(--w-hit-soft);font-weight:800}.nav-toggle{display:none}.site-footer{padding:var(--w-s-10) 0 var(--w-s-6);color:var(--w-muted);font-size:var(--w-fs-sm)}@media(max-width:768px){.site-header__inner{padding:var(--w-s-2) 0;flex-wrap:wrap}.nav-toggle{display:block;margin-left:auto;min-height:var(--w-tap);border:1px solid var(--w-seam-strong);border-radius:var(--w-r-sm);background:var(--w-panel);color:var(--w-ink);font-weight:700}.global-nav{display:grid;order:2;width:100%;margin:0;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--w-s-2)}html.js .global-nav{display:none}html.js .global-nav.is-open{display:grid}html.js .nav-toggle{display:block}html:not(.js) .nav-toggle{display:none}.nav-group summary{border:1px solid var(--w-seam);border-radius:var(--w-r-sm);justify-content:space-between}.nav-menu{left:0;right:auto;width:100%;z-index:2}.w-brand-logo{width:104px}}@media(min-width:769px){.nav-group:hover .nav-menu{display:block}.nav-toggle{display:none}}</style>