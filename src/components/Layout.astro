---
import { ViewTransitions } from 'astro:transitions';
import '../styles/tokens.css';
interface Props { title: string; description: string; section?: 'songs' | 'data' | 'catalogue' | 'about'; }
const { title, description, section } = Astro.props;
const nav = [{ key:'songs',label:'曲目库',items:[['曲目库','/songs/']] },{key:'data',label:'数据',items:[['Jubility 理论值','/jubility/'],['隐藏曲充能','/unlock/']]},{key:'catalogue',label:'图鉴',items:[['版本沿革','/versions/'],['更新情报','/updates/'],['玩法判定','/gameplay/'],['段位图鉴','/dans/']]},{key:'about',label:'关于',items:[['新手上路','/guide/'],['关于本站','/about/']]}] as const;
const flat = nav.flatMap(group => group.items.map(([label, href]) => ({ label, href })));
const canonical = new URL(Astro.url.pathname, 'https://byd-ub.top').href;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} · jubeat 音乐魔方 WIKI</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><ViewTransitions /><script is:inline>(function(){try{var s=localStorage.getItem('jubeat-theme');var d=window.matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.dataset.theme=s||(d?'dark':'light')}catch(e){document.documentElement.dataset.theme='light'}})()</script></head><body><a class="w-skip-link" href="#content">跳到正文</a><header class="site-header" transition:persist><div class="w-shell site-header__inner"><a class="brand" href="/" aria-label="jubeat 音乐魔方 WIKI 首页"><span class="brand__logo" role="img" aria-label="jubeat 音乐魔方"></span><span class="brand__sub">WIKI</span></a><button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><span class="nav-toggle__bars" aria-hidden="true"></span>导航</button><nav id="main-nav" aria-label="主导航" class="global-nav">{nav.map(group => <details class:list={["nav-group",{active:section===group.key}]} name="main-nav-group"><summary><span>{group.label}</span></summary><div class="nav-menu">{group.items.map(([label,href])=><a href={href} aria-current={Astro.url.pathname===href?'page':undefined}><span class="nav-menu__dot" aria-hidden="true"></span>{label}</a>)}</div></details>)}</nav><button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换到黑夜模式" aria-pressed="false"><svg class="theme-toggle__icon theme-toggle__icon--sun" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><svg class="theme-toggle__icon theme-toggle__icon--moon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A8.5 8.5 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg></button></div></header><main id="content" class="w-shell site-main"><slot /></main><footer class="site-footer"><div class="w-shell site-footer__inner"><span class="site-footer__note">非官方中文资料站，与 KONAMI / WAHLAP 无关。数据缺口如实标记，不以推测补全。</span><span class="site-footer__meta">{flat.length} 个入口 · 静态构建</span></div></footer><script>document.documentElement.classList.add('js');
/* document-level listeners bind once per session, not once per navigation */
if(!(window as any).__jubeatChromeBound){
  (window as any).__jubeatChromeBound=true;
  document.addEventListener('click',e=>{const el=e.target;document.querySelectorAll('details.nav-group[open]').forEach(item=>{if(!item.contains(el))item.removeAttribute('open')})});
  document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('details.nav-group[open]').forEach(item=>item.removeAttribute('open'))});
}
const initChrome=()=>{
const button=document.querySelector('.nav-toggle'),nav=document.querySelector('#main-nav');
/* <details> renders open on first paint; collapse every group before it shows. */
document.querySelectorAll('details.nav-group').forEach(item=>item.removeAttribute('open'));
if(button&&nav&&!button.dataset.bound){button.dataset.bound='1';const close=()=>{nav.classList.remove('is-open');button.setAttribute('aria-expanded','false')};button.addEventListener('click',()=>{const open=nav.classList.toggle('is-open');button.setAttribute('aria-expanded',String(open));if(open)nav.querySelector('summary')?.focus()});document.addEventListener('keydown',e=>{if(e.key==='Escape'){close();button.focus()}});nav.addEventListener('click',e=>{if((e.target as Element).closest('a'))close()})}
const toggle=document.getElementById('theme-toggle');
if(toggle&&!toggle.dataset.bound){toggle.dataset.bound='1';const sync=()=>{const dark=document.documentElement.dataset.theme==='dark';toggle.setAttribute('aria-pressed',String(dark));toggle.setAttribute('aria-label',dark?'切换到白天模式':'切换到黑夜模式')};sync();toggle.addEventListener('click',()=>{const next=document.documentElement.dataset.theme==='dark'?'light':'dark';document.documentElement.dataset.theme=next;try{localStorage.setItem('jubeat-theme',next)}catch(e){}sync()})}
};
initChrome();
/* View Transitions rewrites <html>'s attributes on every swap, which drops the
   theme attribute; re-apply it from storage before the new page paints. */
const applyTheme=()=>{try{const saved=localStorage.getItem('jubeat-theme');const dark=window.matchMedia('(prefers-color-scheme: dark)').matches;document.documentElement.dataset.theme=saved||(dark?'dark':'light')}catch(e){document.documentElement.dataset.theme='light'}};
document.addEventListener('astro:after-swap',applyTheme);
/* View Transitions swaps the page body, so re-init on every navigation */
document.addEventListener('astro:page-load',()=>{applyTheme();initChrome()});</script></body></html>
<style>
/* header: translucent bar over the pale cyan field */
.site-header{position:sticky;top:0;z-index:40;border-bottom:1px solid var(--w-seam);background:rgb(255 255 255 / 78%);backdrop-filter:blur(12px) saturate(1.4)}
[data-theme="dark"] .site-header{background:rgb(10 26 38 / 84%)}
.site-header__inner{display:flex;align-items:center;height:var(--w-nav-h);gap:14px}
.brand{display:flex;align-items:center;flex:none;gap:9px;color:var(--w-ink);text-decoration:none}
/* The logo is a CSS mask rather than an <img>: an SVG inside <img> cannot inherit
   the page colour, so masking lets one asset follow the theme. */
.brand__logo{display:block;width:64px;height:26px;background-color:currentColor;-webkit-mask:url('/brand/jubeat-logo.svg') left center/contain no-repeat;mask:url('/brand/jubeat-logo.svg') left center/contain no-repeat}
.brand:hover{color:var(--w-hit-deep)}
.brand__sub{color:var(--w-dim);font-family:var(--w-font-data);font-size:var(--w-fs-micro);letter-spacing:.08em;text-transform:uppercase;white-space:nowrap}

/* theme switch: sun and moon cross-fade in place */
.theme-toggle{position:relative;display:grid;width:36px;height:36px;flex:none;margin-left:var(--w-s-2);place-items:center;border:1px solid var(--w-seam-hi);border-radius:var(--w-r-sm);background:var(--w-panel);color:var(--w-ink-soft);cursor:pointer;box-shadow:var(--w-shadow-card);transition:border-color var(--w-dur-fast) var(--w-ease),color var(--w-dur-fast) var(--w-ease),background var(--w-dur-fast) var(--w-ease)}
.theme-toggle:hover{border-color:var(--w-hit);color:var(--w-ink)}
.theme-toggle__icon{grid-area:1/1;width:17px;height:17px;transition:opacity var(--w-dur-base) var(--w-ease),transform var(--w-dur-base) var(--w-ease)}
.theme-toggle__icon--moon{opacity:0;transform:scale(.55) rotate(-40deg)}
[data-theme="dark"] .theme-toggle__icon--sun{opacity:0;transform:scale(.55) rotate(40deg)}
[data-theme="dark"] .theme-toggle__icon--moon{opacity:1;transform:none}

/* nav: light pills, active inverts to candy */
.global-nav{display:flex;align-items:center;gap:4px;margin-left:auto}
.nav-group{position:relative}
.nav-group summary{display:inline-flex;align-items:center;height:34px;gap:6px;border-radius:var(--w-r-sm);padding:0 13px;color:var(--w-ink-soft);font-size:var(--w-fs-sm);font-weight:600;white-space:nowrap;cursor:pointer;list-style:none;transition:background var(--w-dur-fast) var(--w-ease),color var(--w-dur-fast) var(--w-ease)}
.nav-group summary::-webkit-details-marker{display:none}
.nav-group summary::after{content:"";width:0;height:0;border-top:1.5px solid currentColor;border-right:1.5px solid currentColor;padding:2px;opacity:.55;transform:rotate(45deg) translateY(-1px)}
.nav-group summary:hover{background:var(--w-panel-3);color:var(--w-ink)}
.nav-group.active summary{background:var(--w-hit);color:var(--w-hit-ink);font-weight:800;box-shadow:0 2px 8px var(--w-hit-glow)}
.nav-menu{position:absolute;right:0;top:calc(100% + 4px);z-index:5;min-width:176px;padding:var(--w-s-2);border:1px solid var(--w-seam);border-radius:var(--w-r-md);background:var(--w-panel);box-shadow:var(--w-shadow-lift)}
/* closed by default: <details> is open on load unless we collapse it */
.nav-group:not([open]) .nav-menu{display:none}
.nav-group[open] summary{background:var(--w-panel-3);color:var(--w-ink)}
.nav-menu a{display:flex;align-items:center;height:32px;gap:8px;border-radius:var(--w-r-xs);padding:0 10px;color:var(--w-ink-soft);font-size:var(--w-fs-sm);text-decoration:none}
.nav-menu a:hover{background:var(--w-panel-3);color:var(--w-ink)}
.nav-menu a[aria-current=page]{background:var(--w-hit-wash);color:var(--w-hit-deep);font-weight:700}
.nav-menu__dot{width:5px;height:5px;flex:none;border-radius:50%;background:currentColor;opacity:.45}
.nav-toggle{display:none}

.site-main{padding:var(--w-s-6) 0 var(--w-s-7)}
.site-footer{padding:var(--w-s-6) 0 var(--w-s-6);border-top:1px solid var(--w-seam);color:var(--w-muted);font-size:var(--w-fs-xs)}
.site-footer__inner{display:flex;flex-wrap:wrap;align-items:center;gap:var(--w-s-3)}
.site-footer__note{flex:1;min-width:min(100%,36ch)}
.site-footer__meta{color:var(--w-dim);font-family:var(--w-font-data);font-size:var(--w-fs-micro);letter-spacing:.04em;white-space:nowrap}

@media(max-width:768px){
  .site-header__inner{padding:var(--w-s-2) 0;flex-wrap:wrap;height:auto}
  .nav-toggle{display:inline-flex;align-items:center;height:34px;margin-left:auto;gap:7px;border:1px solid var(--w-seam-hi);border-radius:var(--w-r-sm);background:var(--w-panel);padding:0 12px;color:var(--w-ink);font-size:var(--w-fs-sm);font-weight:700}
  .nav-toggle__bars{width:12px;height:1.5px;background:currentColor;box-shadow:0 -4px 0 currentColor,0 4px 0 currentColor}
  .global-nav{display:grid;order:2;width:100%;margin:0;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--w-s-2)}
  html.js .global-nav{display:none}
  html.js .global-nav.is-open{display:grid}
  html:not(.js) .nav-toggle{display:none}
  .nav-group summary{height:var(--w-tap);border:1px solid var(--w-seam);justify-content:space-between}
  .nav-menu{position:static;min-width:0;margin-top:var(--w-s-1);box-shadow:none}
}
</style>
