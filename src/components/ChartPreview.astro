---
// 铺面预览器：详情页内嵌的 4x4 面板回放 + 音频同步
//
// 数据模型（运行时从 CDN 加载，无构建期预下载）：
//   - 页面只输出空壳：4x4 面板 + 一个「加载预览」按钮
//   - 用户点按钮后，chart-player.js 用 HTTP Range 读远端 .mcz 的中央目录与
//     三难度 .mc（约 9 KB），再把 bgm.ogg 解成 AudioBuffer（波形 / BPM / 精确时钟）
//   - 解压用浏览器原生 DecompressionStream('deflate-raw')
//
// mcz 为空时也照常渲染：构建期索引没命中，交给浏览器用全量清单再找一次
// （src/lib/mcz-match.js 的 findMczForTitle）。找不到才显示「暂无谱面」。
//
// 无 JS 时：面板空态 + 统计文字保留，控件与按钮不渲染（静态可读）

interface DiffItem {
  /** 难度代号小写：bsc / adv / ext */
  diff: string;
  /** 难度显示名：BSC / ADV / EXT */
  short: string;
  /** 构建期已知的统计（无 JS 也能读到） */
  noteCount?: number | null;
  holdCount?: number | null;
  tapCount?: number | null;
  level?: string | number | null;
}

interface Props {
  chartId: string;
  /** 曲目 id（前端兜底匹配时上报用） */
  songId?: string;
  /** 曲目标题：构建期索引没命中时，浏览器拿它去全量清单里找谱面 */
  songTitle?: string;
  /** 曲目级 .mcz CDN 地址（三难度共用一份）；为空时由前端兜底匹配 */
  mcz?: string | null;
  /** 三个难度，顺序即左侧难度栏顺序 */
  diffs: DiffItem[];
  /** 默认选中的难度代号，默认第一个 */
  defaultDiff?: string;
  bpm?: number | string | null;
}

const {
  chartId,
  songId = '',
  songTitle = '',
  mcz = null,
  diffs,
  defaultDiff = diffs[0]?.diff ?? 'ext',
  bpm = null,
} = Astro.props;

// 单预览器：外壳只带曲目级信息，难度由左侧按钮切换（JS 渐进增强）。
// 静态可读性靠这份难度清单 —— 无 JS 时三难度的等级与音符数照样能从页面读到。
const active = diffs.find((d) => d.diff === defaultDiff) ?? diffs[0];
const notesOf = (d: DiffItem) =>
  d.noteCount ?? (d.tapCount != null || d.holdCount != null ? (d.tapCount ?? 0) + (d.holdCount ?? 0) : null);
const labelOf = (d: DiffItem) => `${d.short}${d.level != null ? ` ${d.level}` : ''}`;
// 速率档位：谱面练习常用区间
const RATES = [0.5, 0.75, 1, 1.25, 1.5, 2];
---

<div
  class="jp"
  data-chart-id={chartId}
  data-song-id={songId}
  data-song-title={songTitle}
  data-mcz={mcz ?? ''}
  data-diff={active?.diff ?? defaultDiff}
  data-bpm={bpm ?? ''}
  data-state="idle"
>
  <div class="jp-rail" role="tablist" aria-label="铺面难度">
    <span class="jp-rail-title">难度</span>
    {
      diffs.map((d) => (
        <button
          type="button"
          class="jp-diff w-btn"
          role="tab"
          data-jp-diff={d.diff}
          aria-selected={d.diff === (active?.diff ?? defaultDiff) ? 'true' : 'false'}
          data-note-count={notesOf(d) ?? ''}
        >
          <b class="jp-diff-name">{d.short}</b>
          <span class="jp-diff-lv">{d.level != null ? `Lv ${d.level}` : '—'}</span>
        </button>
      ))
    }
  </div>

  <div class="jp-body">
    <div class="jp-head">
      <span class="jp-label">{labelOf(active)}</span>
      <span class="jp-readout">0.00 / -- s</span>
    </div>

    <div class="jp-stage">
      <div class="jp-pad" role="img" aria-label={`${labelOf(active)} 谱面 4x4 预览`}>
        <svg class="jp-band" aria-hidden="true"></svg>
      </div>

      <div class="jp-gate">
        <button type="button" class="jp-load w-btn">▶ 加载预览</button>
        <span class="jp-status">从 CDN 按需读取谱面、音频与曲绘</span>
      </div>
    </div>

    <div class="jp-controls" hidden>
      <button type="button" class="jp-play w-btn">播放</button>
      <button type="button" class="jp-reset w-btn">重置</button>
      <label class="jp-rate">
        <span class="jp-rate-label">速率</span>
        <select class="jp-rate-select" aria-label="播放速率">
          {RATES.map((r) => <option value={String(r)} selected={r === 1}>{r.toFixed(2).replace(/0$/, '')}×</option>)}
        </select>
      </label>
    </div>

    <div class="jp-timeline">
      <canvas class="jp-wave" width="1200" height="72" aria-hidden="true"></canvas>
      <input type="range" class="jp-scrub" min="0" max="1000" value="0" aria-label="铺面播放进度" />
    </div>

    <p class="jp-meta">
      {
        diffs.every((d) => notesOf(d) == null) ? (
          <span class="jp-note-dim">谱面数据将在加载后显示</span>
        ) : (
          <span class="jp-note-table">
            {diffs.map((d) => (
              <span class="jp-note-row" data-jp-note-diff={d.diff}>
                {d.short} · 音符 {notesOf(d) ?? '—'}
              </span>
            ))}
          </span>
        )
      }
      <span class="jp-audio"></span>
    </p>
  </div>
</div>

<style>
/* 组件自带样式（Astro scoped）：必须放在本文件，
   放在父页面的 <style> 里不会命中本组件的元素。 */
.jp {
  display: grid;
  grid-template-columns: minmax(84px, 108px) minmax(0, 1fr);
  align-items: start;
  gap: var(--w-s-3);
  border: 1px solid var(--w-seam);
  border-radius: var(--w-r-md);
  background: var(--w-grad-panel);
  box-shadow: var(--w-shadow-card);
  padding: var(--w-s-4);
}
.jp[data-state="error"] { border-color: var(--w-hit); }
.jp[data-state="playing"] { border-color: var(--w-hit, var(--w-seam)); }

/* ---- 单预览器外壳：左侧难度栏 + 右侧预览主体 ----
   无 JS 时难度栏照样可读（等级来自构建期数据），面板保持空态。 */
.jp-body { display: grid; gap: var(--w-s-3); min-width: 0; }

.jp-rail {
  display: grid;
  gap: 4px;
  align-content: start;
  padding: 4px;
  border: 1px solid var(--w-seam-soft);
  border-radius: var(--w-r-sm);
  background: var(--w-panel-2);
}
.jp-rail-title { color: var(--w-dim); font-size: var(--w-fs-micro); text-align: center; }
.jp-diff {
  display: grid;
  gap: 1px;
  width: 100%;
  text-align: center;
  /* 未入选难度：低调；`.w-btn` 提供基础外观 */
  opacity: 0.6;
}
.jp-diff-name { font-family: var(--w-font-display); font-size: var(--w-fs-base); letter-spacing: 0.02em; }
.jp-diff-lv { font-family: var(--w-font-data); font-size: var(--w-fs-micro); color: var(--w-muted); }
.jp-diff[aria-selected="true"] {
  opacity: 1;
  border-color: var(--w-hit);
  background: color-mix(in oklab, var(--w-hit) 18%, var(--w-panel));
}
.jp-diff[aria-selected="true"] .jp-diff-lv { color: var(--w-ink); }
.jp-diff:disabled { cursor: default; }
@media (max-width: 560px) {
  /* 窄屏：难度栏折到上方，保持可点面积 */
  .jp { grid-template-columns: minmax(0, 1fr); }
  .jp-rail { grid-auto-flow: column; align-content: stretch; }
}

.jp-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--w-s-2); }
.jp-label { color: var(--w-ink); font-family: var(--w-font-display); font-size: var(--w-fs-base); font-weight: 800; }
.jp-readout { color: var(--w-muted); font-family: var(--w-font-data); font-size: var(--w-fs-micro); }

/* 舞台：曲绘作为背景，加载后由 --jp-cover 注入 */
.jp-stage { position: relative; border-radius: var(--w-r-sm); overflow: hidden; }
.jp.has-cover .jp-pad { position: relative; z-index: 1; }

/* 面板：4×4 单行流。**只声明列，行由 grid-auto-rows 均分** ——
   静态模板里不展开 16 格，格子由 chart-player.js 的 padMarkup() 注入；
   这样模板可以永远保持「空面板」，静态可读性不依赖这层。 */
.jp-pad {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-auto-rows: 1fr;
  gap: 6px;
  aspect-ratio: 1 / 1;
  width: 100%;
  padding: 8px;
  border-radius: var(--w-r-sm);
  background: var(--w-panel-2);
  box-sizing: border-box;
}

/* ---- 长押带子层 ----
   长押必须是一根跨格不断的连续结构，但 .jp-key 有 overflow:hidden、
   格与格之间还有 6px 间隙，靠每个格子各画一段必然断裂。
   所以用一层覆盖整个面板的 SVG 来画「连接线 + 三角头」：
   不设 viewBox，坐标直接用面板像素（JS 按 getBoundingClientRect 反算格心），
   这样 stroke 宽度不被非等比拉伸扭曲。

   **必须 grid-area: 1 / 1 / -1 / -1** —— .jp-pad 是 4×4 的 grid，
   SVG 是它第一个子元素，不钉住网格区域的话会自己占掉第一个格子，
   把后面 16 个 .jp-key 整体挤错位一格。 */
.jp-band {
  position: absolute;
  inset: 0;
  grid-area: 1 / 1 / -1 / -1;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 2;
  overflow: visible;
}
/* 长押元素用实色画：color-mix(in oklab, var(--w-hit) …) 在 SVG 里会失败回落成黑色，
   所以颜色由 chart-player.js 从 tokens 读出的 --jp-hit / --jp-hit-deep 直接给。 */
/* 下面三条必须 :global()：它们匹配的 <polygon> 是 chart-player.js 用
   bandSvg.innerHTML = 注入的，节点上永远不会有 data-astro-cid-*，
   scoped 写法（.jp-band[data-astro-cid-x] polygon…）在真机上是死规则，
   带子会落到 SVG 默认的黑填充上。
   注意只需要包「选择器串」这一层，别把 .jp-band 自己那条也包进去——
   那条选择的是模板里静态写的 <svg class="jp-band">，本来就生效。 */
:global(.jp-band) polygon {
  stroke-linejoin: round;
}
/* 连接线：细，且比三角头淡，避免抢视觉 */
:global(.jp-band) .jp-band-line {
  fill: var(--jp-hit, #38c6e6);
  stroke: none;
  opacity: 0.4;
}
/* 三角头：尖端朝起点（往回指），底边朝前进方向 */
:global(.jp-band) .jp-band-head {
  fill: var(--jp-hit, #38c6e6);
  stroke: var(--jp-hit-deep, #1490b4);
  stroke-width: 1;
}

/* 有曲绘时：面板半透明压在曲绘上 */
.jp.has-cover .jp-pad { background: color-mix(in oklab, var(--w-panel-2) 72%, transparent); }

:global(.jp-key) {
  position: relative;
  display: block;
  border-radius: var(--w-r-xs);
  background: var(--w-panel);
  border: 1px solid var(--w-seam-soft);
  overflow: hidden;
  --jp-anim: 0;
  --jp-hold: 0;
}

/* ---- 数字提示：格内右下角显示该音符的全谱序号 ----
   只在音符处于活动状态时出现（由 render 写入 data-jp-seq），
   空格子不放数字，避免整块面板变成数字表。 */
:global(.jp-key[data-jp-seq]::after) {
  content: attr(data-jp-seq);
  position: absolute;
  right: 3px;
  bottom: 1px;
  font-size: 9px;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  color: var(--w-ink, #fff);
  text-shadow: 0 0 3px rgba(0, 0, 0, 0.85), 0 0 1px rgba(0, 0, 0, 0.9);
  opacity: 0.9;
  pointer-events: none;
  z-index: 3;
}

/* ---- 双押提示：同一时刻要同时按的格子用同一个色相高亮 ----
   --jp-simul 是该组的色相角（黄金角跳色，相邻组差异明显）。
   单押不带这个变量，所以不会被染色。 */
:global(.jp-key.is-simul.is-tap::before) {
  border-color: hsl(var(--jp-simul) 92% 62%);
  background: color-mix(in oklab, hsl(var(--jp-simul) 92% 62%) 30%, transparent);
  box-shadow: 0 0 8px hsl(var(--jp-simul) 92% 62% / 0.55);
}
:global(.jp-key.is-simul.is-tap) {
  border-color: hsl(var(--jp-simul) 92% 62%);
}
/* 长押也参与同时押时，起点/终点同样染色 */
:global(.jp-key.is-simul.is-hold-root),
:global(.jp-key.is-simul.is-hold-end) {
  border-color: hsl(var(--jp-simul) 92% 62%);
  box-shadow: 0 0 0 2px hsl(var(--jp-simul) 92% 62% / 0.5), 0 0 14px var(--w-hit-wash);
}

/* ---- tap：判定点前「从四个角向中心闭合」，闭合的那一刻就是判定点 ----
   --jp-anim: 0(四个角刚出现) .. 1(四角合拢填满整格 = 判定点)，单向不回头；
   颜色从白 -> 谱面主色，让「即将判定」和「已判定」在颜色上也能区分。
   判定之后由 .is-tap-passed 接管，--jp-passed: 0 .. 1 就地淡出
   （--jp-passed 由 chart-player.js 在 tap 判定期写入）。 */
:global(.jp-key.is-tap) {
  background: color-mix(in oklab, var(--w-hit) calc(var(--jp-anim) * 55%), var(--w-panel));
  border-color: color-mix(in oklab, var(--w-hit) calc(var(--jp-anim) * 100%), var(--w-seam-soft));
  box-shadow: 0 0 calc(var(--jp-anim) * 10px) var(--w-hit-wash);
}
/* 填充层：四个角各有一个等腰直角三角，随 --jp-anim 向中心长大，
   到 --jp-anim=1 时四块正好拼满整格 —— 这个瞬间就是判定点。
   用 conic-gradient 一次画四个角，避免四个伪元素。
   底色从白（刚出现）过渡到谱面主色（合拢时），呼应「从白色到充满颜色」。 */
:global(.jp-key.is-tap::before) {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: var(--w-r-xs);
  --jp-fill: color-mix(in oklab, var(--w-hit) calc(var(--jp-anim) * 100%), white);
  --jp-spread: calc(50% + var(--jp-anim) * 0.5%);
  background:
    conic-gradient(
        at 0% 0%,
        var(--jp-fill) 0deg 90deg,
        transparent 90deg
      )
      left top / var(--jp-spread) var(--jp-spread) no-repeat,
    conic-gradient(
        at 100% 0%,
        var(--jp-fill) 270deg 360deg,
        transparent 0deg
      )
      right top / var(--jp-spread) var(--jp-spread) no-repeat,
    conic-gradient(
        at 0% 100%,
        var(--jp-fill) 0deg 90deg,
        transparent 90deg
      )
      left bottom / var(--jp-spread) var(--jp-spread) no-repeat,
    conic-gradient(
        at 100% 100%,
        var(--jp-fill) 270deg 360deg,
        transparent 0deg
      )
      right bottom / var(--jp-spread) var(--jp-spread) no-repeat;
  opacity: calc(0.35 + var(--jp-anim) * 0.65);
  pointer-events: none;
}
/* 判定点命中：整格是实色，作为「就是现在」的确认 */
:global(.jp-key.is-tap.is-tap-passed) {
  background: var(--w-hit);
  border-color: color-mix(in oklab, var(--w-hit) 70%, white);
  box-shadow: 0 0 0 calc((1 - var(--jp-passed, 0)) * 3px) var(--w-hit),
    0 0 14px var(--w-hit);
  opacity: calc(1 - var(--jp-passed, 0) * 0.9);
}
/* 判定后：填满的实色块就地淡出（不外扩、不散开） */
:global(.jp-key.is-tap.is-tap-passed::before) {
  background: var(--w-hit);
  opacity: calc(1 - var(--jp-passed, 0));
}

/* ---- hold：长按 + 一条跨格不断的长条 ----
   jubeat 的长押是「长按」：手指按住起点格不放，起点格全程高亮，
   格子上留一个**朝前进方向开口的三角缺口**（和长条头形状呼应），
   长条头沿起点 -> 终点的连接线滑过去，中间是一根细连接线。
   连接线和三角头由 .jp-band 这层 SVG 画，格子这里只负责底色和缺口。 */

/* 起点格：长按位置，全程高亮，格子上挖一个**深色等腰三角**。
   缺口朝「长押往哪走」开口，方向由 JS 按四个正交方向写成 data-jp-dir。
   为什么不用 clip-path 切：切开会让格子轮廓缺一角，看着像被咬掉；
   改成在亮色块上叠一个面板底色的等腰三角，格子仍是完整方块，
   只是「贴着行进方向那条边的中点凹进去一块」，形状与三角头呼应。
   尺寸刻意做小（深 20%、底边 34%）：格子只有约 45px，切太深会吃掉半个格。 */
:global(.jp-key.is-hold-root) {
  background: var(--w-hit);
  border-color: var(--w-hit);
  box-shadow: 0 0 0 2px var(--w-hit-wash), 0 0 12px var(--w-hit-wash);
}
:global(.jp-key.is-hold-root::before) {
  content: "";
  position: absolute;
  inset: 0;
  /* 色值与被压住的背景一致：面板底色（有曲绘时是半透明面板） */
  background: var(--w-panel-2);
  pointer-events: none;
  z-index: 1;
  /* 等腰三角：默认朝右开口（尖端朝向格心） */
  clip-path: polygon(100% 50%, 80% 33%, 80% 67%);
}
:global(.jp-key.is-hold-root[data-jp-dir="right"]::before) {
  clip-path: polygon(100% 50%, 80% 33%, 80% 67%);
}
:global(.jp-key.is-hold-root[data-jp-dir="left"]::before) {
  clip-path: polygon(0% 50%, 20% 67%, 20% 33%);
}
:global(.jp-key.is-hold-root[data-jp-dir="down"]::before) {
  clip-path: polygon(50% 100%, 33% 80%, 67% 80%);
}
:global(.jp-key.is-hold-root[data-jp-dir="up"]::before) {
  clip-path: polygon(50% 0%, 67% 20%, 33% 20%);
}

/* 终点格：长条头到这里，给一圈描边呼应三角头的方向 */
:global(.jp-key.is-hold-end) {
  border-color: color-mix(in oklab, var(--w-hit) 78%, white);
  box-shadow: 0 0 0 2px var(--w-hit-wash), inset 0 0 12px var(--w-hit-wash);
}

/* 到终点后的收合（复用 tap 的动画变量） */
:global(.jp-key.is-closing) {
  background: color-mix(in oklab, var(--w-hit) calc(var(--jp-anim) * 100%), var(--w-panel));
  border-color: color-mix(in oklab, var(--w-hit) calc(var(--jp-anim) * 100%), var(--w-seam-soft));
  transform: scale(calc(0.97 + var(--jp-anim) * 0.06));
}

/* 曲绘背景层：加载后才有内容 */
.jp.has-cover .jp-stage::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: var(--jp-cover);
  background-size: cover;
  background-position: center;
  filter: blur(10px) saturate(0.9) brightness(0.55);
  transform: scale(1.12);
}

/* 加载门。注意 z-index 必须高于 .jp-pad（has-cover 时被抬到 z-index:1），
   否则按钮会被格子盖住只露一点点。 */
.jp-gate {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: grid;
  place-content: center;
  gap: var(--w-s-2);
  justify-items: center;
  text-align: center;
  padding: var(--w-s-3);
  background: color-mix(in oklab, var(--w-ink) 42%, transparent);
  border-radius: var(--w-r-sm);
}
/* `hidden` 属性会被上面的 display:grid 覆盖掉，必须显式还原。 */
.jp-gate[hidden] { display: none; }
.jp-status { color: #fff; font-size: var(--w-fs-micro); text-shadow: 0 1px 3px rgb(0 0 0 / 0.7); }

.jp-controls { display: flex; align-items: center; gap: var(--w-s-2); flex-wrap: wrap; }
.jp-controls[hidden] { display: none; }
.jp-rate { display: inline-flex; align-items: center; gap: 4px; margin-left: auto; }
.jp-rate-label { color: var(--w-muted); font-size: var(--w-fs-micro); }
.jp-rate-select {
  background: var(--w-panel);
  color: var(--w-ink);
  border: 1px solid var(--w-seam-soft);
  border-radius: var(--w-r-xs);
  padding: 2px 4px;
  font-family: var(--w-font-data);
  font-size: var(--w-fs-micro);
}

/* 时间轴：波形画在进度条底下，两者共用同一横向尺度 */
.jp-timeline { position: relative; display: grid; gap: 2px; }
.jp-wave {
  display: block;
  width: 100%;
  height: 36px;
  border-radius: var(--w-r-xs);
  background: var(--w-panel-2);
}
.jp-scrub { width: 100%; min-width: 0; accent-color: var(--w-hit); }

.jp-meta { margin: 0; color: var(--w-muted); font-size: var(--w-fs-micro); }
.jp-note-dim { color: var(--w-dim); }
.jp-note-table { display: inline-flex; flex-wrap: wrap; gap: 2px var(--w-s-2); }
.jp-note-row { font-family: var(--w-font-data); white-space: nowrap; }
.jp-audio { color: var(--w-dim); }

/* 无 JS：隐藏交互控件与难度切换（按钮是靠 JS 接线的），
   保留面板空态与难度清单（静态可读） */
:global(html:not(.js)) .jp-controls { display: none; }
:global(html:not(.js)) .jp-timeline { display: none; }
:global(html:not(.js)) .jp-gate { display: none; }
:global(html:not(.js)) .jp-diff { pointer-events: none; }
:global(html:not(.js)) .jp-pad { opacity: 0.72; }
@media (prefers-reduced-motion: reduce) { :global(.jp-key) { transition: none; } }
</style>
