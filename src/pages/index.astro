---
import Layout from '../components/Layout.astro';
import { songs, meta } from '../lib/data';
const chartCount = songs.reduce((total, song) => total + song.chartCount, 0);
const stats = [
  ['本站曲目', songs.length],
  ['可玩谱面', chartCount],
  ['已收录曲绘', meta.counts.jackets],
  ['充能池', meta.counts.unlockPools],
];
const areas = [
  ['曲目库', '按曲名、谱面等级与来源找到每一首。', '/songs/', '曲', 'green'],
  ['数据', '查看理论值与五池解禁资料。', '/jubility/', '数', 'blue'],
  ['图鉴', '从版本与玩法理解音乐魔方。', '/versions/', '鉴', 'orange'],
  ['关于', '了解数据口径、缺口与纠错方式。', '/about/', '於', 'pink'],
];
const gaps = [
  ['无曲绘', meta.missing.covers, 'gaps-covers.json'],
  ['BPM 缺失', meta.missing.bpm, 'official-catalog'],
  ['暂无考据', meta.missing.remywiki, 'remywiki.index'],
  ['谱面不完整', meta.missing.incompleteCharts, 'levels'],
];
---
<Layout title="首页" description="jubeat 音乐魔方国服曲目、谱面、解禁和考据的可追溯中文资料站。">
  <section class="hero">
    <div class="hero__body">
      <div class="hero__head">
        <div>
          <span class="hero__eyebrow">CN · WAHLAP / 可追溯资料站</span>
          <h1 class="hero__title">找到那一首，<br/>也找到它的来处。</h1>
          <p class="hero__lede">曲目、谱面、定数、解禁和考据统一收录。每个数字都保留来源，可信差异会并列说明。</p>
          <div class="hero__actions">
            <a class="wp-btn wp-btn--solid" href="/songs/">进入全量曲目库</a>
            <a class="wp-btn" href="/guide/">新手上路</a>
          </div>
        </div>
        <div class="hero__brand">
          <span class="hero__brand-frame"><img src="/brand/jubeat-music-cube-logo.webp" alt="jubeat 音乐魔方"/></span>
        </div>
      </div>
      <form action="/songs/" class="hero__search">
        <label class="hero__search-label" for="hero-search">快捷检索</label>
        <div class="wp-search">
          <span class="wp-search__icon" aria-hidden="true"></span>
          <input class="w-field" id="hero-search" name="q" placeholder="搜索曲名或 artist" autocomplete="off"/>
          <button class="wp-search__kbd" type="submit" aria-label="搜索">/</button>
        </div>
      </form>
      <div class="hero__stats">
        {stats.map(([label, value]) => <div class="hero__stat"><strong>{value}</strong><span>{label}</span></div>)}
      </div>
      <p class="hero__legal">本站为非官方资料站；KONAMI、WAHLAP 等名称及相关内容归其权利人所有。</p>
    </div>
    <div class="hero__pad" aria-hidden="true">
      <div class="w-pad-4x4">{Array.from({length:16}).map((_, i) => <span class="w-pad-key" data-difficulty={i === 1 ? 'bsc' : i === 7 ? 'adv' : i === 14 ? 'ext' : undefined}></span>)}</div>
    </div>
  </section>

  <section class="section">
    <h2 class="wp-h2">四分区入口<span class="wp-h2__note">按用途划分的四个入口</span></h2>
    <div class="areas">
      {areas.map(([name, desc, href, mark, tone]) => <a href={href} class="area w-card"><span class={`wp-dia wp-dia--${tone}`} aria-hidden="true"><b>{mark}</b></span><span class="area__text"><strong>{name}</strong><small>{desc}</small></span><span class="area__arrow" aria-hidden="true">→</span></a>)}
    </div>
  </section>

  <section class="section">
    <h2 class="wp-h2">资料完整度<span class="wp-h2__note">缺口照实列出，不以推测补全</span></h2>
    <div class="gaps">
      {gaps.map(([label, count, source]) => <div class="gap w-card"><strong>{count}</strong><span class="gap__label">{label}</span><span class="gap__src">{source}</span></div>)}
    </div>
  </section>

  <section class="section">
    <h2 class="wp-h2">从哪里开始</h2>
    <div class="split">
      <article class="w-panel">
        <h3 class="split__h">完整静态列表</h3>
        <p class="split__p">全量曲目已直接输出在页面内；即使未启用 JavaScript，也能按曲名进入每一首的资料页。</p>
        <a class="split__link" href="/songs/">进入全量曲目库 →</a>
      </article>
      <article class="w-panel">
        <h3 class="split__h">解禁与充能</h3>
        <p class="split__p">{meta.counts.unlockPools} 个充能池按 CHERRY / KUMQUAT / LIME / BLUEBERRY / RAINBOW 分池登记，未匹配条目一并列出。</p>
        <a class="split__link" href="/unlock/">查看充能条件 →</a>
      </article>
      <article class="w-panel">
        <h3 class="split__h">资料政策</h3>
        <p class="split__p">多源冲突保留候选值与差额，不做静默合并；字段缺失一律保持 null。</p>
        <a class="split__link" href="/about/">查看来源与缺口说明 →</a>
      </article>
    </div>
  </section>
</Layout>
<style>
/* hero: candy field with white stat strip, echoing the tournament key visual */
.hero{position:relative;overflow:hidden;border-radius:var(--w-r-xl);background:linear-gradient(155deg,#6ad3ee 0%,#9ce4f6 34%,#c8eefa 62%,#e2e8fb 100%);padding:var(--w-s-7) var(--w-s-7) var(--w-s-6);box-shadow:var(--w-shadow-lift)}
.hero::before{position:absolute;inset:0;content:"";pointer-events:none;background-image:linear-gradient(135deg,rgb(255 255 255 / 22%) 25%,transparent 25% 75%,rgb(255 255 255 / 22%) 75%),linear-gradient(135deg,rgb(255 255 255 / 14%) 25%,transparent 25% 75%,rgb(255 255 255 / 14%) 75%);background-position:0 0,34px 34px;background-size:136px 136px,136px 136px;opacity:.7}
.hero::after{position:absolute;top:-90px;right:-60px;width:340px;height:340px;border-radius:50%;background:radial-gradient(circle,rgb(255 255 255 / 30%) 0%,transparent 68%);content:"";pointer-events:none}
.hero__body{position:relative;z-index:1;display:grid;gap:var(--w-s-5)}
.hero__head{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:start;gap:var(--w-s-5)}
.hero__eyebrow{display:inline-block;color:rgb(255 255 255 / 88%);font-size:var(--w-fs-xs);letter-spacing:var(--w-track-cap);text-transform:uppercase}
.hero__title{margin:var(--w-s-2) 0 0;color:#fff;font-family:var(--w-font-display);font-size:var(--w-fs-display);font-weight:800;line-height:var(--w-lh-tight);text-shadow:0 2px 12px rgb(4 60 78 / 18%)}
.hero__lede{max-width:56ch;margin:var(--w-s-3) 0 0;color:rgb(255 255 255 / 94%);line-height:var(--w-lh-body)}
.hero__actions{display:flex;flex-wrap:wrap;gap:var(--w-s-2);margin-top:var(--w-s-4)}
.hero__actions .wp-btn{border-color:rgb(255 255 255 / 55%);background:rgb(255 255 255 / 18%);color:#fff;box-shadow:none}
.hero__actions .wp-btn:hover{border-color:#fff;background:rgb(255 255 255 / 30%);color:#fff}
.hero__actions .wp-btn--solid{border-color:#fff;background:#fff;color:var(--w-hit-deep)}
.hero__actions .wp-btn--solid:hover{border-color:#fff;background:#fff;color:var(--w-field-deep)}
.hero__brand{display:grid;place-items:center;padding:var(--w-s-3);border-radius:var(--w-r-lg);background:rgb(255 255 255 / 92%)}
.hero__brand-frame img{display:block;width:clamp(120px,15vw,168px);height:auto}
.hero__search{display:block;max-width:620px}
.hero__search-label{display:block;margin-bottom:var(--w-s-2);color:rgb(255 255 255 / 92%);font-size:var(--w-fs-sm);font-weight:700}
.hero__search .w-field{background:rgb(255 255 255 / 94%);border-color:rgb(255 255 255 / 70%)}
.hero__search .wp-search__kbd{background:var(--w-panel-3);cursor:pointer}
.hero__stats{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--w-s-2)}
.hero__stat{display:grid;gap:2px;border-radius:var(--w-r-md);background:rgb(255 255 255 / 16%);padding:var(--w-s-3) var(--w-s-4)}
.hero__stat strong{color:#fff;font-family:var(--w-font-display);font-size:var(--w-fs-stat);font-weight:800;line-height:1.1}
.hero__stat span{color:rgb(255 255 255 / 86%);font-size:var(--w-fs-xs)}
.hero__legal{margin:0;color:rgb(255 255 255 / 78%);font-size:var(--w-fs-xs);line-height:var(--w-lh-body)}
.hero__pad{position:absolute;z-index:0;right:var(--w-s-5);bottom:var(--w-s-5);opacity:.55;pointer-events:none}
.hero__pad .w-pad-4x4{width:184px;background:rgb(255 255 255 / 14%);gap:6px;padding:6px}
.hero__pad .w-pad-key{border-color:rgb(255 255 255 / 30%);background:rgb(255 255 255 / 22%)}

.section{margin-top:var(--w-s-7)}
.areas{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--w-s-3)}
.area{display:grid;grid-template-columns:38px 1fr auto;align-items:center;gap:var(--w-s-3);color:var(--w-ink);text-decoration:none}
.area__icon{display:grid;width:38px;height:38px;place-items:center;border-radius:var(--w-r-sm);background:var(--w-hit-wash);color:var(--w-hit-deep);font-family:var(--w-font-display);font-size:var(--w-fs-lg);font-weight:800}
.area:hover .area__icon{background:var(--w-hit);color:var(--w-hit-ink)}
.area__text{display:grid;gap:2px;min-width:0}
.area__text strong{font-family:var(--w-font-display);font-size:var(--w-fs-lg);font-weight:800}
.area__text small{color:var(--w-muted);font-size:var(--w-fs-xs);line-height:1.6}
.area__arrow{color:var(--w-dim);transition:transform var(--w-dur-base) var(--w-ease),color var(--w-dur-base) var(--w-ease)}
.area:hover .area__arrow{color:var(--w-hit);transform:translateX(3px)}

.gaps{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--w-s-3)}
.gap{display:grid;gap:2px;padding:var(--w-s-4) var(--w-s-5)}
.gap strong{color:var(--w-adv);font-family:var(--w-font-display);font-size:var(--w-fs-stat);font-weight:800;line-height:1.1}
.gap__label{color:var(--w-ink);font-size:var(--w-fs-sm);font-weight:700}
.gap__src{color:var(--w-dim);font-family:var(--w-font-data);font-size:var(--w-fs-micro)}

.split{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--w-s-3)}
.split__h{margin:0 0 var(--w-s-2);color:var(--w-ink);font-family:var(--w-font-display);font-size:var(--w-fs-lg);font-weight:800}
.split__p{margin:0 0 var(--w-s-3);color:var(--w-ink-soft);font-size:var(--w-fs-sm);line-height:var(--w-lh-body)}
.split__link{color:var(--w-hit-deep);font-size:var(--w-fs-sm);font-weight:700;text-decoration:none}
.split__link:hover{text-decoration:underline}

@media(max-width:1024px){
  .hero{padding:var(--w-s-6) var(--w-s-5)}
  .hero__head{grid-template-columns:1fr;gap:var(--w-s-4)}
  .hero__brand{justify-self:start}
  .areas,.gaps,.split{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:768px){
  .hero__stats{grid-template-columns:repeat(2,1fr)}
  .hero__pad{display:none}
}
@media(max-width:520px){
  .areas,.gaps,.split{grid-template-columns:1fr}
  .hero__stats{grid-template-columns:1fr 1fr}
  .area{grid-template-columns:34px 1fr auto}
}
</style>
