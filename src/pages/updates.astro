---
import Layout from '../components/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { meta, unlock, jubility } from '../lib/data';
const generated = new Date(meta.generatedAt).toLocaleString('zh-CN', { timeZone: 'UTC' });
const updates = [
  ['数据快照', `生成于 ${generated} UTC`, '本站以离线数据构建，构建不联网。'],
  ['Jubility 表', `资料日期 ${jubility.updatedAt}`, `${jubility.entries.length} 条理论值记录已纳入数据页。`],
  ['充能池 Phase 2', '2026-06-30', `五池共 ${unlock.poolRawTotal} 条原始曲目记录，未匹配项保留标记。`],
];
---
<Layout title="更新情报" description="本站收录数据的快照和已知更新记录。" section="catalogue">
  <PageIntro eyebrow="CATALOGUE / BULLETIN" title="更新情报" lead="本站只发布可追溯的资料状态；不是实时运营公告，也不会把未知信息包装成更新。"/>

  <section class="wp-section" aria-labelledby="feed-title">
    <h2 class="wp-h2" id="feed-title">资料状态<span class="wp-h2__note">共 {updates.length} 条</span></h2>
    <div class="feed">
      {updates.map(([title, date, text]) => <article class="entry w-panel">
        <header class="entry__head">
          <h3 class="entry__title">{title}</h3>
          <time class="entry__time">{date}</time>
        </header>
        <p class="wp-prose entry__text">{text}</p>
      </article>)}
    </div>
  </section>
</Layout>
<style>
.feed{display:grid;gap:var(--w-s-3);max-width:820px}
.entry{display:grid;gap:var(--w-s-2)}
.entry__head{display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--w-s-3)}
.entry__title{margin:0;color:var(--w-ink);font-family:var(--w-font-display);font-size:var(--w-fs-lg);font-weight:800}
.entry__time{color:var(--w-hit-deep);font-family:var(--w-font-data);font-size:var(--w-fs-xs)}
.entry__text{margin:0}
</style>
