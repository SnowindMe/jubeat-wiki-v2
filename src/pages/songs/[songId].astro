---
import Layout from '../../components/Layout.astro';
import ChartPreview from '../../components/ChartPreview.astro';
import { songs, jubility, diffLabels, display, songHref, songPathId, sourceLabel, meta } from '../../lib/data';
import { conflictsForSong, conflictMeta } from '../../scripts/data-conflicts.js';
import { loadMczIndex } from '../../lib/mcz-index.js';
export function getStaticPaths() { return songs.map(song => ({ params: { songId: songPathId(song.songId) }, props: { song } })); }
const { song } = Astro.props;
const index = songs.findIndex(item => item.songId === song.songId);
const previous = songs[index - 1];
const next = songs[index + 1];
const diffs = ['bsc', 'adv', 'ext'] as const;
const noteKey = { bsc: 'basic', adv: 'advanced', ext: 'extreme' } as const;
const jubi = jubility.entries.filter(entry => entry.songId === song.songId);
const fieldConflicts = conflictsForSong(song.songId);
const sourceFor = (field: string) => song.fieldSources?.[field as keyof typeof song.fieldSources] ?? song.sources[0] ?? 'unknown';

// 谱面数据源：构建期只查索引（songId -> CDN .mcz 地址），不下载任何谱面文件。
// 索引没命中的曲目也照常渲染预览容器：浏览器会用全量清单再兜底找一次
// （src/lib/mcz-match.js），所以「仓库里有没有」最终由前端说了算。
const mczIndex = loadMczIndex();
const mczEntry = mczIndex[String(song.songId)] ?? null;
const mczUrl = mczEntry?.url ?? null;
---

<Layout title={`${song.title} 的谱面难度、来源、解禁与考据资料。`} description={`${song.title} 的谱面难度、来源、解禁与考据资料。`} section="songs">
  <nav class="crumb" aria-label="面包屑">
    <a href="/songs/">曲目库</a><span class="crumb__sep" aria-hidden="true">/</span><span aria-current="page">{song.title}</span>
  </nav>

  <article class="detail">
    <header class="detail__head w-panel">
      <div class="detail__cover w-cover-slot">
        {song.cover ? <img src={song.cover} alt={`${song.title} 曲绘`}/> : <div class="detail__nopad w-pad-4x4" aria-hidden="true">{Array.from({length:16}).map(() => <span class="w-pad-key"></span>)}</div>}
      </div>
      <div class="detail__intro">
        <span class="wp-eyebrow">{song.category} · {song.origin}</span>
        <h1 class="detail__title">{song.title}</h1>
        <p class="detail__artist">{song.artist ?? '暂无 artist 数据'}</p>
        <div class="detail__diffs">
          {diffs.map(diff => <a class="w-difficulty" data-difficulty={diff} href={`#chart-${diff}`}>{diffLabels[diff]} <b>{display(song.levels[diff], '—')}</b></a>)}
        </div>
        <dl class="facts">
          <div><dt>BPM <small>{sourceLabel(sourceFor('bpm'))}</small></dt><dd>{display(song.bpm)}</dd></div>
          <div><dt>原机种 <small>{sourceLabel(sourceFor('origin'))}</small></dt><dd>{song.origin}</dd></div>
          <div><dt>上线批次</dt><dd>{display(song.addedBatch)}</dd></div>
          <div><dt>谱面数</dt><dd>{song.chartCount} / 3</dd></div>
        </dl>
        {song.hasAltChart && <p class="notice">含 [2] 第二谱面标记。</p>}
      </div>
    </header>

    <section class="w-panel" id="chart">
      <h2 class="wp-h2">谱面难度<span class="wp-h2__note">每行标注字段来源</span></h2>
      <div class="table-scroll" tabindex="0" aria-label="谱面难度表，可横向滚动">
        <table>
          <thead><tr><th scope="col">难度</th><th scope="col">等级</th><th scope="col">原始标记</th><th scope="col">NOTE 数</th><th scope="col">字段来源</th><th scope="col">铺面</th></tr></thead>
          <tbody>{diffs.map(diff => <tr id={`chart-${diff}`}>
            <th scope="row"><span class="w-difficulty" data-difficulty={diff}>{diffLabels[diff]}</span></th>
            <td class="cell-num">{display(song.levels[diff], '未上线')}</td>
            <td>{display(song.levelMarks[diff])}</td>
            <td class="cell-num">{display(song.notecounts?.[noteKey[diff]])}</td>
            <td>{sourceLabel(sourceFor(diff))}</td>
            <td class="cell-act">
              <a class="jp-jump w-btn" href={`#preview-${diff}`} data-jp-jump={diff}>▶ 预览</a>
            </td>
          </tr>)}</tbody>
        </table>
      </div>
      <p class="jp-note">
        铺面数据来自 .mcz 谱面包（Malody 格式，第三方谱面资料），仅供查阅与练谱参考。谱面、音频与曲绘在点击预览时从 CDN 按需加载。
      </p>
    </section>

    <section class="w-panel" id="preview">
      <h2 class="wp-h2">铺面预览<span class="wp-h2__note">4×4 面板回放 · 按需加载</span></h2>
      <div class="jp-grid">
        {diffs.map(diff => (
          <div class="jp-slot" id={`preview-${diff}`}>
            <ChartPreview
              chartId={`${song.songId}-${diff}`}
              songId={String(song.songId)}
              songTitle={song.title}
              mcz={mczUrl}
              diff={diff}
              label={`${diffLabels[diff]} ${display(song.levels[diff], '')}`.trim()}
              bpm={song.bpm}
              level={display(song.levels[diff], null)}
            />
          </div>
        ))}
      </div>
    </section>

    {fieldConflicts.length > 0 && <section class="w-panel">
      <h2 class="wp-h2">字段差异说明<span class="wp-h2__note">多源冲突不静默合并</span></h2>
      <p class="lead">权威值为当前数据层采用的值；候选值来自审计中保留的历史/原始记录，不会静默抹平。</p>
      {fieldConflicts.map(conflict => <details class="conflict">
        <summary>{conflict.field}：当前值 {display((song as any)[conflict.field.split('.')[0]] ?? conflict.raw)}</summary>
        <dl><div><dt>权威值（当前页）</dt><dd>{display(conflict.raw)}</dd></div><div><dt>旧记录候选值</dt><dd>{display(conflict.old)}</dd></div><div><dt>差异说明</dt><dd>{conflict.note ?? '原始重解析值与旧站缓存不同。'}</dd></div></dl>
      </details>)}
    </section>}

    {song.levelHistory.length > 0 && <section class="w-panel">
      <h2 class="wp-h2">难度沿革<span class="wp-h2__note">历史版本记录</span></h2>
      <ol class="history">{song.levelHistory.map(item => <li><strong>{item.game}</strong><span>BSC {display(item.bsc)} · ADV {display(item.adv)} · EXT {display(item.ext)}</span></li>)}</ol>
    </section>}

    <section class="w-panel">
      <h2 class="wp-h2">获取方式</h2>
      <dl class="facts">
        <div><dt>解禁池</dt><dd>{song.unlockPool ?? '无需充能'}</dd></div>
        <div><dt>阶段</dt><dd>{song.poolPhase ? `Phase ${song.poolPhase}` : '—'}</dd></div>
        <div><dt>兑换费用</dt><dd>{display(song.exchangeCost)}</dd></div>
      </dl>
    </section>

    {jubi.length > 0 && <section class="w-panel">
      <h2 class="wp-h2">Jubility 参考<span class="wp-h2__note">按难度分列</span></h2>
      <ul class="jubi">{jubi.map(entry => <li><strong>{entry.diff} {entry.constant.toFixed(1)}</strong><span>通常 {display(entry.valueNormal)} · HARD {display(entry.valueHard)} · {entry.section}</span></li>)}</ul>
    </section>}

    <section class="w-panel">
      <h2 class="wp-h2">页面数据来源</h2>
      <p class="lead">数据生成于 {new Date(meta.generatedAt).toLocaleString('zh-CN', { timeZone: 'UTC' })} UTC。曲目来源：{song.sources.map(sourceLabel).join('、')}。冲突审计生成于 {conflictMeta.generatedAt}。</p>
    </section>

    <nav class="adjacent" aria-label="相邻曲目">
      {previous ? <a class="adj" href={songHref(previous.songId)}><span class="adj__dir">← 上一首</span><strong>{previous.title}</strong></a> : <span class="adj adj--empty"></span>}
      {next && <a class="adj adj--next" href={songHref(next.songId)}><span class="adj__dir">下一首 →</span><strong>{next.title}</strong></a>}
    </nav>
  </article>
</Layout>

<script>
  import { mountAll } from '../../lib/chart-player.js';
  // 与站点既有约定一致：View Transitions 下用 astro:page-load 重新挂载。
  // 无条件加载：没有预览器的页面 mountAll 会自然空转，代价可忽略。
  const initJp = () => { try { mountAll(); } catch (err) { console.error('[jp]', err); } };
  if (document.readyState !== 'loading') initJp();
  else document.addEventListener('DOMContentLoaded', initJp);
  document.addEventListener('astro:page-load', initJp);
</script>
<style>
.crumb{display:flex;flex-wrap:wrap;align-items:center;gap:var(--w-s-2);margin:var(--w-s-2) 0 var(--w-s-4);font-size:var(--w-fs-sm)}
.crumb a{color:var(--w-muted);text-decoration:none}
.crumb a:hover{color:var(--w-hit-deep)}
.crumb__sep{color:var(--w-dim)}
.crumb [aria-current]{color:var(--w-ink);font-weight:700}

.detail{display:grid;gap:var(--w-s-4);margin-bottom:var(--w-s-6)}
.detail > *{min-width:0}

.detail__head{display:grid;grid-template-columns:minmax(180px,300px) 1fr;align-items:start;gap:var(--w-s-6)}
.detail__cover{display:block;border-radius:var(--w-r-md);overflow:hidden;background:var(--w-panel-2)}
.detail__cover img{width:100%;height:auto;aspect-ratio:1;object-fit:cover}
.detail__nopad{width:58%;opacity:.5}
.detail__title{margin:var(--w-s-2) 0 0;color:var(--w-ink);font-family:var(--w-font-display);font-size:var(--w-fs-h1);font-weight:800;line-height:var(--w-lh-tight)}
.detail__artist{margin:var(--w-s-1) 0 0;color:var(--w-ink-soft);font-size:var(--w-fs-lg)}
.detail__diffs{display:flex;flex-wrap:wrap;gap:var(--w-s-2);margin-top:var(--w-s-4)}
.detail__diffs .w-difficulty{height:26px;padding:0 10px;text-decoration:none}
.detail__diffs .w-difficulty b{font-family:var(--w-font-display);font-size:var(--w-fs-sm)}

.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(132px,1fr));gap:var(--w-s-3);margin:var(--w-s-4) 0 0}
.facts dt{color:var(--w-muted);font-size:var(--w-fs-xs)}
.facts dt small{display:block;color:var(--w-dim);font-size:var(--w-fs-micro);font-weight:400}
.facts dd{margin:2px 0 0;color:var(--w-ink);font-family:var(--w-font-data);font-size:var(--w-fs-lg);font-weight:700}
.notice{margin:var(--w-s-4) 0 0;border-left:3px solid var(--w-hit);border-radius:0 var(--w-r-xs) var(--w-r-xs) 0;background:var(--w-hit-wash);padding:var(--w-s-2) var(--w-s-3);color:var(--w-ink-soft);font-size:var(--w-fs-xs)}

.table-scroll{overflow-x:auto;border-radius:var(--w-r-sm)}
.table-scroll:focus{outline:2px solid var(--w-focus);outline-offset:2px}
table{width:100%;min-width:620px;border-collapse:collapse;font-size:var(--w-fs-sm)}
th,td{padding:var(--w-s-3) var(--w-s-2);border-bottom:1px solid var(--w-seam-soft);text-align:left}
thead th{color:var(--w-muted);font-size:var(--w-fs-xs);font-weight:700;border-bottom-color:var(--w-seam)}
tbody tr:last-child th,tbody tr:last-child td{border-bottom:0}
tbody tr:target{background:var(--w-hit-wash)}
.cell-num{font-family:var(--w-font-display);font-size:var(--w-fs-lg);font-weight:800;color:var(--w-ink)}

.lead{margin:0 0 var(--w-s-3);color:var(--w-ink-soft);font-size:var(--w-fs-sm);line-height:var(--w-lh-body)}
.history,.jubi{display:grid;gap:var(--w-s-2);margin:0;padding:0;list-style:none}
.history li,.jubi li{display:grid;gap:2px;border-radius:var(--w-r-sm);background:var(--w-panel-2);padding:var(--w-s-3)}
.history strong,.jubi strong{color:var(--w-ink);font-family:var(--w-font-display);font-size:var(--w-fs-base)}
.history span,.jubi span{color:var(--w-muted);font-size:var(--w-fs-xs)}

.conflict{border-top:1px solid var(--w-seam-soft);padding:var(--w-s-2) 0}
.conflict summary{cursor:pointer;color:var(--w-ink);font-size:var(--w-fs-sm);font-weight:700}
.conflict dl{display:grid;grid-template-columns:max-content 1fr;gap:var(--w-s-2) var(--w-s-4);margin:var(--w-s-3) 0 0;padding:var(--w-s-3);border-radius:var(--w-r-sm);background:var(--w-panel-2)}
.conflict dt{color:var(--w-muted);font-size:var(--w-fs-xs)}
.conflict dd{margin:0;color:var(--w-ink-soft);font-size:var(--w-fs-sm)}

.adjacent{display:grid;grid-template-columns:1fr 1fr;gap:var(--w-s-3)}
.adj{display:grid;gap:2px;border:1px solid var(--w-seam);border-radius:var(--w-r-pill);background:var(--w-grad-panel);box-shadow:var(--w-shadow-card);padding:var(--w-s-3) var(--w-s-5);text-decoration:none;transition:border-color var(--w-dur-base) var(--w-ease),box-shadow var(--w-dur-base) var(--w-ease),transform var(--w-dur-base) var(--w-ease)}
.adj:hover{border-color:var(--w-seam-hi);box-shadow:var(--w-shadow-lift);transform:translateY(-1px)}
.adj--next{text-align:right}.adj--empty{border:0;background:none;box-shadow:none}
.adj__dir{color:var(--w-muted);font-size:var(--w-fs-xs)}
.adj strong{color:var(--w-ink);font-family:var(--w-font-display);font-size:var(--w-fs-lg);font-weight:800}
.adj:hover strong{color:var(--w-hit-deep)}

/* ---- 铺面预览（仅本页布局；卡片内样式在 ChartPreview.astro） ---- */
.cell-act{white-space:nowrap}
.jp-jump{display:inline-flex;align-items:center;gap:4px;height:26px;padding:0 12px;border-radius:var(--w-r-pill);border:1px solid var(--w-seam);background:var(--w-panel-2);color:var(--w-ink-soft);font-size:var(--w-fs-xs);font-weight:700;text-decoration:none;transition:border-color var(--w-dur-base) var(--w-ease),color var(--w-dur-base) var(--w-ease)}
.jp-jump:hover{border-color:var(--w-hit);color:var(--w-hit-deep)}
.jp-none{color:var(--w-dim)}
.jp-note{margin:var(--w-s-3) 0 0;color:var(--w-dim);font-size:var(--w-fs-micro)}

.jp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:var(--w-s-4);align-items:start}
.jp-slot{min-width:0}
.jp-slot:target{outline:2px solid var(--w-hit);outline-offset:4px;border-radius:var(--w-r-sm)}

@media(max-width:768px){
  .detail__head{grid-template-columns:1fr;gap:var(--w-s-4)}
  .detail__cover{max-width:220px}
}
@media(max-width:600px){
  .adjacent{grid-template-columns:1fr}
  .adj--next{text-align:left}
  .conflict dl{grid-template-columns:1fr;gap:var(--w-s-1)}
}
</style>
