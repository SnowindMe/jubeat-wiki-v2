---
import Layout from '../../components/Layout.astro'; import SongBits from '../../components/SongBits.astro';
import { songs, jubility, diffLabels, display, songHref, songPathId, sourceLabel, meta } from '../../lib/data'; import { conflictsForSong, conflictMeta } from '../../scripts/data-conflicts.js';
export function getStaticPaths() { return songs.map(song => ({ params:{songId:songPathId(song.songId)},props:{song} })); }
const { song } = Astro.props; const index=songs.findIndex(item=>item.songId===song.songId); const previous=songs[index-1]; const next=songs[index+1]; const diffs=['bsc','adv','ext'] as const; const jubi=jubility.entries.filter(entry=>entry.songId===song.songId); const fieldConflicts=conflictsForSong(song.songId); const sourceFor=(field:string)=>song.fieldSources?.[field as keyof typeof song.fieldSources] ?? song.sources[0] ?? 'unknown';
---
<Layout title={song.title} description={`${song.title} 的谱面难度、来源、解禁与考据资料。`} section="songs"><nav class="crumb" aria-label="面包屑"><a href="/songs/">曲目库</a><span aria-hidden="true"> / </span><a href="/songs/" aria-label="曲目库二级索引">曲目库</a><span aria-hidden="true"> / </span><span aria-current="page">{song.title}</span></nav><article class="song-detail"><header class="w-panel detail-head"><SongBits song={song}/><div><p class="eyebrow">{song.category} · {song.origin}</p><h1>{song.title}</h1><p class="artist">{song.artist ?? '暂无 artist 数据'}</p><dl class="facts"><div><dt>BPM <small>{sourceLabel(sourceFor('bpm'))}</small></dt><dd>{display(song.bpm)}</dd></div><div><dt>原机种 <small>{sourceLabel(sourceFor('origin'))}</small></dt><dd>{song.origin}</dd></div><div><dt>上线批次</dt><dd>{display(song.addedBatch)}</dd></div></dl>{song.hasAltChart&&<p class="notice">含 [2] 第二谱面标记。</p>}</div></header><section class="w-panel"><h2>谱面难度</h2><div class="table-scroll" tabindex="0" aria-label="谱面难度表，可横向滚动"><table><thead><tr><th scope="col">难度</th><th scope="col">等级</th><th scope="col">原始标记</th><th scope="col">NOTE 数</th><th scope="col">字段来源</th></tr></thead><tbody>{diffs.map(diff=><tr><th scope="row"><span class="w-difficulty" data-difficulty={diff}>{diffLabels[diff]}</span></th><td>{display(song.levels[diff],'未上线')}</td><td>{display(song.levelMarks[diff])}</td><td>{display(song.notecounts?.[diff==='bsc'?'basic':diff==='adv'?'advanced':'extreme'])}</td><td>{sourceLabel(sourceFor(diff))}</td></tr>)}</tbody></table></div></section>{fieldConflicts.length>0&&<section class="w-panel conflicts"><h2>字段差异说明</h2><p>权威值为当前数据层采用的值；候选值来自审计中保留的历史/原始记录，不会静默抹平。</p>{fieldConflicts.map(conflict=><details><summary>{conflict.field}：当前值 {display((song as any)[conflict.field.split('.')[0]] ?? conflict.raw)}</summary><dl><div><dt>权威值（当前页）</dt><dd>{display(conflict.raw)}</dd></div><div><dt>旧记录候选值</dt><dd>{display(conflict.old)}</dd></div><div><dt>差异说明</dt><dd>{conflict.note ?? '原始重解析值与旧站缓存不同。'}</dd></div></dl></details>)}</section>}<section class="w-panel page-source"><h2>页面数据来源</h2><p>数据生成于 {new Date(meta.generatedAt).toLocaleString('zh-CN',{timeZone:'UTC'})} UTC。曲目来源：{song.sources.map(sourceLabel).join('、')}。冲突审计生成于 {conflictMeta.generatedAt}。</p></section>{song.levelHistory.length>0&&<section class="w-panel"><h2>难度沿革</h2><ol class="history">{song.levelHistory.map(item=><li><strong>{item.game}</strong><span>BSC {display(item.bsc)} · ADV {display(item.adv)} · EXT {display(item.ext)}</span></li>)}</ol></section>}<section class="w-panel"><h2>获取方式</h2><dl class="facts"><div><dt>解禁池</dt><dd>{song.unlockPool??'无需充能'}</dd></div><div><dt>阶段</dt><dd>{song.poolPhase?`Phase ${song.poolPhase}`:'—'}</dd></div><div><dt>兑换费用</dt><dd>{display(song.exchangeCost)}</dd></div></dl></section>{jubi.length>0&&<section class="w-panel"><h2>Jubility 参考</h2><ul class="jubi">{jubi.map(entry=><li><strong>{entry.diff} {entry.constant.toFixed(1)}</strong><span>通常 {display(entry.valueNormal)} · HARD {display(entry.valueHard)} · {entry.section}</span></li>)}</ul></section>}<nav class="adjacent" aria-label="相邻曲目">{previous?<a href={songHref(previous.songId)}>← {previous.title}</a>:<span/>}{next&&<a href={songHref(next.songId)}>{next.title} →</a>}</nav></article></Layout>
<style>.crumb{margin-top:var(--w-s-5);font-size:var(--w-fs-sm)}.song-detail{display:grid;gap:var(--w-s-4);margin:var(--w-s-5) 0}.song-detail>*{min-width:0}.detail-head{display:grid;grid-template-columns:minmax(160px,280px) 1fr;gap:var(--w-s-6)}.detail-head .cover{max-width:280px}.detail-head h1,h2{font-family:var(--w-font-display)}.detail-head h1{font-size:var(--w-fs-3xl);margin:var(--w-s-2) 0}.eyebrow{color:var(--w-hit-deep);font-family:var(--w-font-data)}.artist{color:var(--w-ink-soft);font-size:var(--w-fs-lg)}.facts{display:flex;flex-wrap:wrap;gap:var(--w-s-3);margin:var(--w-s-4) 0}.facts div{min-width:130px}.facts dt{color:var(--w-muted);font-size:var(--w-fs-sm)}.facts dt small{display:block;font-weight:400}.facts dd{margin:0;font-family:var(--w-font-data);font-weight:700}.table-scroll{overflow-x:auto}.table-scroll:focus{outline:3px solid var(--w-focus);outline-offset:3px}table{width:100%;min-width:620px;border-collapse:collapse}th,td{padding:var(--w-s-2);border-bottom:1px solid var(--w-seam);text-align:left}.history,.jubi{padding-left:var(--w-s-5)}.history li,.jubi li{padding:var(--w-s-2) 0;border-bottom:1px solid var(--w-seam)}.history span,.jubi span{display:block;color:var(--w-ink-soft)}.adjacent{display:grid;grid-template-columns:1fr 1fr;gap:var(--w-s-3)}.adjacent a:last-child{text-align:right}.notice{border-left:3px solid var(--w-hit);padding-left:var(--w-s-2)}.conflicts details{margin-top:var(--w-s-2);border-top:1px solid var(--w-seam);padding:var(--w-s-2) 0}.conflicts summary{cursor:pointer;font-weight:700}.conflicts dl{display:grid;grid-template-columns:max-content 1fr;gap:var(--w-s-2) var(--w-s-4);margin:var(--w-s-3) 0}.conflicts dd{margin:0}.page-source p{margin:0;color:var(--w-ink-soft)}@media(max-width:600px){.detail-head{grid-template-columns:1fr}.detail-head .cover{max-width:200px}.adjacent{grid-template-columns:1fr}.adjacent a:last-child{text-align:left}.conflicts dl{grid-template-columns:1fr;gap:0}.conflicts dd{margin-bottom:var(--w-s-2)}}</style>