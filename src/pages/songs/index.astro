---
import Layout from '../../components/Layout.astro';
import SongBits from '../../components/SongBits.astro';
import { songs, songHref } from '../../lib/data';
const origins = [...new Set(songs.map(song => song.origin).filter(Boolean))].sort();
const pools = [...new Set(songs.map(song => song.unlockPool).filter(Boolean))].sort();
const sources = [...new Set(songs.flatMap(song => song.sources))].sort();
const source = Astro.url.searchParams.get('source') ?? '';
const shownSongs = source ? songs.filter(song => song.sources.includes(source)) : songs;
---
<Layout title="曲目库" description={`收录 ${songs.length} 首 jubeat 音乐魔方曲目，提供谱面等级、来源和解禁资料。`} section="songs"><div class="crumb"><a href="/songs/" aria-current="page">曲目库</a></div><header class="page-heading"><div><h1>曲目库</h1><p>共 {songs.length} 首{source ? ` / 当前来源筛选：${source}` : ''}。表格正文直接静态输出，筛选仅作为可选增强。</p></div><strong>{shownSongs.length} 首</strong></header><form class="w-panel filters" action="/songs/"><div class="w-filter-bar"><label>检索<input class="w-field" name="q" placeholder="曲名 / artist"/></label><label>难度<select class="w-field" name="level"><option value="">所有难度</option><option value="bsc">BASIC</option><option value="adv">ADVANCED</option><option value="ext">EXTREME</option></select></label><label>原机种<select class="w-field" name="origin"><option value="">所有原机种</option>{origins.map(origin => <option value={origin!}>{origin}</option>)}</select></label><label>解禁池<select class="w-field" name="pool"><option value="">所有解禁池</option>{pools.map(pool => <option value={pool!}>{pool}</option>)}</select></label><label>来源<select class="w-field" name="source"><option value="">所有来源</option>{sources.map(item => <option value={item} selected={item === source}>{item}</option>)}</select></label></div><button>应用筛选</button></form><section class="w-panel overview"><h2>统计概览</h2><p>完整三谱面 {songs.filter(s => s.chartCount === 3).length} 首 · 有考据条目 {songs.filter(s => s.hasRemywiki).length} 首 · PICK UP {songs.filter(s => s.isPickUp).length} 首 · 无曲绘 {songs.filter(s => !s.cover).length} 首</p></section><section aria-labelledby="result-title"><h2 id="result-title">全部结果</h2><div class="song-list">{shownSongs.map(song => <article class="song-row w-card w-hit-target"><SongBits song={song} compact={true}/><div class="song-copy"><h3><a href={songHref(song.songId)}>{song.title}</a>{song.hasAltChart && <small> [2] 谱面</small>}</h3><p>{song.artist ?? '暂无 artist 数据'}</p><dl><div><dt>原机种</dt><dd>{song.origin}</dd></div><div><dt>解禁池</dt><dd>{song.unlockPool ?? '无需充能'}</dd></div><div><dt>上线批次</dt><dd>{song.addedBatch ?? '暂无记录'}</dd></div></dl></div></article>)}</div></section></Layout>
<style>.crumb{margin-top:var(--w-s-5);font-size:var(--w-fs-sm)}.page-heading{display:flex;justify-content:space-between;align-items:end;margin:var(--w-s-6) 0}.page-heading h1{font-family:var(--w-font-display);font-size:var(--w-fs-3xl);margin:0}.page-heading p{color:var(--w-ink-soft)}.page-heading strong{font-family:var(--w-font-data);font-size:var(--w-fs-xl);color:var(--w-hit-deep)}.filters label{display:grid;gap:var(--w-s-1);font-size:var(--w-fs-sm);font-weight:700}.filters button{min-height:var(--w-tap);margin-top:var(--w-s-3);border:1px solid var(--w-hit-deep);border-radius:var(--w-r-sm);background:var(--w-hit);color:var(--w-on-hit);font-weight:800;padding:0 var(--w-s-4)}.overview{margin-top:var(--w-s-4)}.overview h2{margin-top:0;font-family:var(--w-font-display)}.song-list{display:grid;gap:var(--w-s-3)}.song-row{display:grid;grid-template-columns:104px 1fr;gap:var(--w-s-4);padding:var(--w-s-3)}.song-row .cover{max-width:104px}.song-copy h3{margin:0;font-size:var(--w-fs-lg)}.song-copy p{margin:var(--w-s-1) 0;color:var(--w-ink-soft)}dl{display:flex;flex-wrap:wrap;gap:var(--w-s-3);margin:var(--w-s-2) 0 0;font-size:var(--w-fs-sm)}dt{color:var(--w-muted)}dd{margin:0;font-family:var(--w-font-data)}@media(max-width:520px){.page-heading{align-items:start;gap:var(--w-s-2);flex-direction:column}.song-row{grid-template-columns:76px 1fr}.song-row .cover{max-width:76px}.song-row .difficulty-list{display:none}dl{display:grid;grid-template-columns:1fr 1fr}}</style>