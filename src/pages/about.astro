---
import Layout from '../components/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { meta } from '../lib/data';
const generated = new Date(meta.generatedAt).toLocaleString('zh-CN', { timeZone: 'UTC' });
const build = [
  ['数据生成时间', `${generated} UTC`],
  ['构建版本', `数据架构 v${meta.schemaVersion} · ${meta.buildMode} build`],
  ['收录规模', `${meta.counts.songs} 首曲目 / ${meta.counts.difficultyIndex} 个谱面索引 / ${meta.counts.jackets} 张曲绘文件`],
];
const gaps = [
  ['无曲绘', meta.missing.covers],
  ['BPM 缺失', meta.missing.bpm],
  ['暂无考据', meta.missing.remywiki],
  ['谱面不完整', meta.missing.incompleteCharts],
];
---
<Layout title="关于本站" description="jubeat 音乐魔方 WIKI 的数据口径、构建信息和缺口说明。" section="about">
  <PageIntro eyebrow="ABOUT / PROVENANCE" title="关于本站" lead="jubeat 音乐魔方 WIKI 是非官方中文资料站：把已抓取资料做成静态、可链接、可核对的阅读入口。"/>

  <section class="w-panel" aria-labelledby="build-title">
    <h2 class="wp-h2" id="build-title">构建信息</h2>
    <dl class="wp-dl">
      {build.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
    </dl>
  </section>

  <section class="w-panel wp-section" aria-labelledby="policy-title">
    <h2 class="wp-h2" id="policy-title">资料口径</h2>
    <p class="wp-prose">{meta.provenancePolicy}</p>
    <div class="wp-pills gaps">
      {gaps.map(([label, count]) => <span class="wp-badge">{label} {count}</span>)}
    </div>
    <p class="wp-prose">以上缺口不会用推测值填补；缺失字段一律保持 null。</p>
  </section>

  <section class="w-panel wp-section" aria-labelledby="rights-title">
    <h2 class="wp-h2" id="rights-title">来源与权利</h2>
    <p class="wp-prose">数据来源记录于各曲目和数据条目；历史快照、官方 API 与资料索引的具体来源见数据字段。</p>
    <p class="wp-prose">本项目为非官方站点，与 KONAMI、WAHLAP 无隶属关系；相关名称及素材权利归原权利人所有。</p>
  </section>

  <div class="wp-pills cta">
    <a class="wp-btn" href="/guide/">新手上路</a>
    <a class="wp-btn" href="/updates/">更新情报</a>
  </div>
</Layout>
<style>
.gaps{margin:var(--w-s-3) 0}
.gaps .wp-badge{font-family:var(--w-font-data)}
.cta{margin-top:var(--w-s-6)}
</style>
