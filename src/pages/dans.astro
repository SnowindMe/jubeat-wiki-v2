---
import Layout from '../components/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
const tiers = [
  ['入门', '熟悉 4×4 面板与基础节拍。'],
  ['进阶', '建立读谱与双手分工。'],
  ['挑战', '针对高密度、出张与混合节奏训练。'],
  ['段位资料', '当前离线数据层未包含可验证的完整段位条件。'],
];
---
<Layout title="段位图鉴" description="jubeat 段位与练习阅读入口。" section="catalogue">
  <PageIntro eyebrow="CATALOGUE / DAN" title="段位图鉴" lead="段位是把读谱、节奏与稳定性放在同一组课题里的练习坐标。本站不会以猜测补全尚未核验的条件。"/>

  <section class="w-panel" aria-labelledby="reading-title">
    <h2 class="wp-h2" id="reading-title">阅读方式<span class="wp-h2__note">按阶段推进</span></h2>
    <ol class="wp-list wp-list--num tiers">
      {tiers.map(([name, desc]) => <li><strong>{name}</strong>：{desc}</li>)}
    </ol>
    <p class="wp-prose note">需要从歌曲开始安排练习时，可按等级浏览 <a href="/songs/">曲目库</a>，并在 <a href="/gameplay/#glossary">玩法术语表</a> 中确认用语。</p>
  </section>
</Layout>
<style>
.tiers li strong{color:var(--w-ink);font-family:var(--w-font-display);font-weight:800}
.note{margin-top:var(--w-s-4)}
</style>
