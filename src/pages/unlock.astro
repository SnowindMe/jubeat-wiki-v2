---
import Layout from '../components/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { unlock, songs, songHref, meta, sourceLabel } from '../lib/data';

const poolEntries = Object.entries(unlock.pools);
const actualTotal = unlock.poolActualTotal;
const rawTotal = unlock.poolRawTotal;
const difference = rawTotal - actualTotal;
const unmatched = unlock.poolsUnmatched;

// Data contract: the two counting bases and their gap are fixed facts.
if (difference !== 6 || actualTotal !== 179 || rawTotal !== 185) throw new Error('unlock 双口径数据断言失败：预期 179 / 185 / 6');
if (!unmatched.every(item => item.pool && item.phase && item.title && item.reason)) throw new Error('unlock 未匹配清单缺少必要字段');

const byId = new Map(songs.map(song => [song.songId, song]));
const coverFor = (songId: string | null) => (songId ? byId.get(songId)?.cover ?? null : null);
const scope = [
  ['本站可匹配曲目', actualTotal, '以可稳定对应曲目库 songId 的实际归属计数。'],
  ['remywiki 原始条目', rawTotal, '保留源表阶段列表的原始条目口径。'],
  ['差额', difference, `RAINBOW Phase 2 有 ${difference} 条 [2] 变体未提升为独立曲目对象，无法按 songId / 标题匹配，故不计入可匹配总数，但逐条保留。`],
];
---
<Layout title="隐藏曲充能" description="jubeat 音乐魔方五个隐藏曲充能池的离线资料与双口径说明。" section="data">
  <PageIntro eyebrow="DATA / FIVE POOLS" title="隐藏曲充能" lead="五个充能池及阶段曲目。可匹配项目可直接进入曲目详情；未匹配条目保留原始记录，不伪造链接。"/>

  <section class="w-panel" aria-labelledby="scope-title">
    <h2 class="wp-h2" id="scope-title">收录口径与差额<span class="wp-h2__note">两套计数基准并列</span></h2>
    <div class="wp-grid wp-grid--3">
      {scope.map(([label, value, note]) => <div class="scope">
        <span class="scope__label">{label}</span>
        <strong class="scope__value">{value}</strong>
        <span class="scope__note">{note}</span>
      </div>)}
    </div>
    <p class="wp-prose source">来源：{sourceLabel(unlock.source)}；数据生成于 {new Date(meta.generatedAt).toLocaleString('zh-CN', { timeZone: 'UTC' })} UTC。</p>
  </section>

  <div class="pools">
    {poolEntries.map(([name, pool]) => {
      const actual = unlock.poolCounts[name as keyof typeof unlock.poolCounts];
      const raw = unlock.poolRawCounts[name as keyof typeof unlock.poolRawCounts];
      const poolActual = actual.phase1 + actual.phase2;
      const poolRaw = raw.phase1 + raw.phase2;
      const phases = [[1, pool.phase1, raw.phase1, actual.phase1, null], [2, pool.phase2, raw.phase2, actual.phase2, pool.phase2Note]] as const;
      return <section class="w-pool-card pool" data-pool={name.toLowerCase()}>
        <header class="pool__head">
          <h2 class="pool__name">{name}</h2>
          <span class="pool__window">{pool.phase1Window.from} ～ {pool.phase1Window.to}</span>
          <div class="wp-pills pool__counts">
            <span class="wp-badge wp-badge--hit">可匹配 {poolActual}</span>
            <span class="wp-badge">原始 {poolRaw}</span>
            <span class="wp-badge">差额 {poolRaw - poolActual}</span>
          </div>
        </header>
        <div class="pool__phases">
          {phases.map(([phase, list, rawCount, actualCount, note]) => <section class="phase">
            <h3 class="phase__h">阶段 {phase}<span class="phase__count">原始 {rawCount} / 可匹配 {actualCount}</span></h3>
            {note && <p class="phase__note">{note}</p>}
            <ul class="chips">
              {list.map(song => <li class="chip">
                {song.songId
                  ? <a href={songHref(song.songId)}>
                      {coverFor(song.songId) ? <img src={coverFor(song.songId)!} alt="" loading="lazy"/> : <span class="chip__pad" aria-hidden="true"></span>}
                      <span class="chip__title">{song.title}</span>
                    </a>
                  : <span class="chip__raw">
                      <span class="chip__pad" aria-hidden="true"></span>
                      <span class="chip__title">{song.title}</span>
                      <span class="wp-badge">未匹配</span>
                    </span>}
              </li>)}
            </ul>
            {phase === 2 && pool.phase2Detail.length > 0 && <details class="phase-detail">
              <summary>Phase 2 源表补充资料（机种 / 等级）</summary>
              <ul class="wp-list wp-list--dot">{pool.phase2Detail.map(detail => <li><b>{detail.title}</b>：{detail.origin} · {detail.levels}</li>)}</ul>
            </details>}
          </section>)}
        </div>
      </section>;
    })}
  </div>

  <section class="w-panel wp-section" aria-labelledby="unmatched-title">
    <h2 class="wp-h2" id="unmatched-title">未匹配原始条目<span class="wp-h2__note">{unmatched.length} 条</span></h2>
    <p class="wp-prose">以下条目来自源表，但当前数据层没有可稳定对应的独立 songId，因此均不提供详情链接。此清单不等于总数差额：其中也包含源表中本就未进入本站曲库的曲目。</p>
    <div class="wp-table-wrap" tabindex="0" aria-label="未匹配原始条目表，可横向滚动">
      <table class="wp-table">
        <thead><tr><th scope="col">池</th><th scope="col">阶段</th><th scope="col">原始条目名</th><th scope="col">未匹配原因</th></tr></thead>
        <tbody>{unmatched.map(item => <tr>
          <td>{item.pool}</td>
          <td>Phase {item.phase}</td>
          <td>{item.title}</td>
          <td>{item.reason}（{sourceLabel(item.source)}）</td>
        </tr>)}</tbody>
      </table>
    </div>
  </section>
</Layout>
<style>
.scope{display:grid;gap:2px;border-radius:var(--w-r-sm);background:var(--w-panel-2);padding:var(--w-s-4)}
.scope__label{color:var(--w-muted);font-size:var(--w-fs-xs)}
.scope__value{color:var(--w-hit-deep);font-family:var(--w-font-data);font-size:var(--w-fs-stat);font-weight:800;line-height:1.1}
.scope__note{color:var(--w-muted);font-size:var(--w-fs-xs);line-height:1.6}
.source{margin-top:var(--w-s-4);color:var(--w-muted);font-size:var(--w-fs-xs)}

.pools{display:grid;gap:var(--w-s-4);margin-top:var(--w-s-5)}
.pools > *{min-width:0}
.pool{display:grid;gap:var(--w-s-4)}
.pool__head{display:grid;gap:var(--w-s-2)}
.pool__name{margin:0;color:var(--w-pool-color,var(--w-ink));font-family:var(--w-font-display);font-size:var(--w-fs-h2);font-weight:800}
.pool__window{color:var(--w-muted);font-family:var(--w-font-data);font-size:var(--w-fs-xs)}
.pool__counts{margin-top:var(--w-s-1)}
.pool__phases{display:grid;grid-template-columns:1fr 1fr;gap:var(--w-s-5)}
.phase{display:grid;align-content:start;gap:var(--w-s-2);min-width:0}
.phase__h{display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--w-s-2);margin:0;color:var(--w-ink);font-family:var(--w-font-display);font-size:var(--w-fs-lg);font-weight:800}
.phase__count{color:var(--w-muted);font-family:var(--w-font-data);font-size:var(--w-fs-xs);font-weight:400}
.phase__note{margin:0;color:var(--w-muted);font-size:var(--w-fs-xs);line-height:1.6}

/* song chips: tiny cover plus title, so the pool reads as songs rather than text */
.chips{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(100%,220px),1fr));gap:var(--w-s-1);margin:0;padding:0;list-style:none}
.chip > a,.chip__raw{display:flex;align-items:center;gap:var(--w-s-2);border-radius:var(--w-r-pill);background:var(--w-panel-2);padding:3px var(--w-s-3) 3px 3px;color:var(--w-ink);font-size:var(--w-fs-xs);text-decoration:none}
.chip > a:hover{background:var(--w-hit-wash);color:var(--w-hit-deep)}
.chip img,.chip__pad{width:24px;height:24px;flex:none;border-radius:var(--w-r-xs)}
.chip img{object-fit:cover}
.chip__pad{background:linear-gradient(135deg,var(--w-panel-3) 50%,var(--w-seam-soft) 50%)}
.chip__title{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.chip__raw{opacity:.72}
.chip__raw .wp-badge{flex:none;height:18px;font-size:var(--w-fs-micro)}
.phase-detail{margin-top:var(--w-s-2);font-size:var(--w-fs-sm)}
.phase-detail summary{cursor:pointer;color:var(--w-ink);font-weight:700}

@media(max-width:900px){.pool__phases{grid-template-columns:1fr}}
</style>
