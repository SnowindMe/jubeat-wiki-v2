---
import Layout from '../components/Layout.astro'; import PageIntro from '../components/PageIntro.astro'; import { unlock, songHref, meta, sourceLabel } from '../lib/data';
const pools = Object.entries(unlock.pools);
const actualTotal = unlock.poolActualTotal; const rawTotal = unlock.poolRawTotal; const difference = rawTotal - actualTotal;
const unmatched = unlock.poolsUnmatched;
if (difference !== 6 || actualTotal !== 179 || rawTotal !== 185) throw new Error('unlock 双口径数据断言失败：预期 179 / 185 / 6');
if (!unmatched.every(item => item.pool && item.phase && item.title && item.reason)) throw new Error('unlock 未匹配清单缺少必要字段');
---
<Layout title="隐藏曲充能" description="jubeat 音乐魔方五个隐藏曲充能池的离线资料与双口径说明。" section="data"><PageIntro eyebrow="DATA / FIVE POOLS" title="隐藏曲充能" lead="五个充能池及阶段曲目。可匹配项目可直接进入曲目详情；未匹配条目保留原始记录，不伪造链接。"/>
<section class="w-panel overview" aria-labelledby="scope-title"><h2 id="scope-title">收录口径与差额</h2><dl><div><dt>本站可匹配曲目总数</dt><dd>{actualTotal} 条</dd><small>以可稳定对应曲目库 songId 的实际归属计数。</small></div><div><dt>remywiki 列表原始条目总数</dt><dd>{rawTotal} 条</dd><small>保留源表阶段列表的原始条目口径。</small></div><div><dt>差额</dt><dd>{difference} 条</dd><small>RAINBOW Phase 2 中有 {difference} 条 [2] 变体未提升为独立曲目对象；它们无法按稳定 songId / 标题匹配，因此不计入可匹配曲目总数，但在下方原始清单逐条保留。</small></div></dl><p class="source">来源：{sourceLabel(unlock.source)}；数据生成于 {new Date(meta.generatedAt).toLocaleString('zh-CN',{timeZone:'UTC'})} UTC。</p></section>
<div class="pools">{pools.map(([name,pool]) => { const actual = unlock.poolCounts[name as keyof typeof unlock.poolCounts]; const raw = unlock.poolRawCounts[name as keyof typeof unlock.poolRawCounts]; const poolActual=actual.phase1+actual.phase2; const poolRaw=raw.phase1+raw.phase2; return <section class="w-pool-card" data-pool={name.toLowerCase()}><h2>{name}</h2><p>{pool.phase1Window.from} ～ {pool.phase1Window.to}</p><p class="pool-counts">本站可匹配 <b>{poolActual}</b> 条（P1 {actual.phase1} / P2 {actual.phase2}） · remywiki 原始 <b>{poolRaw}</b> 条（P1 {raw.phase1} / P2 {raw.phase2}） · 差额 <b>{poolRaw-poolActual}</b> 条</p><div class="columns"><div><h3>阶段 1 <small>原始 {raw.phase1} / 可匹配 {actual.phase1}</small></h3><ol>{pool.phase1.map(song => <li>{song.songId ? <a href={songHref(song.songId)}>{song.title}</a> : <span>{song.title} <em>未匹配 / 暂无详情链接</em></span>}</li>)}</ol></div><div><h3>阶段 2 <small>原始 {raw.phase2} / 可匹配 {actual.phase2}</small></h3><p>{pool.phase2Note}</p><ol>{pool.phase2.map(song => <li>{song.songId ? <a href={songHref(song.songId)}>{song.title}</a> : <span>{song.title} <em>未匹配 / 暂无详情链接</em></span>}</li>)}</ol><details class="phase-detail"><summary>Phase 2 源表补充资料（机种 / 等级）</summary><ul>{pool.phase2Detail.map(detail=><li><b>{detail.title}</b>：{detail.origin} · {detail.levels}</li>)}</ul></details></div></div></section>})}</div>
<section class="w-panel unmatched" aria-labelledby="unmatched-title"><h2 id="unmatched-title">未匹配原始条目清单</h2><p>以下条目来自源表，但当前数据层没有可稳定对应的独立 songId；因此均不提供详情链接。此清单不等于总数差额：其中也包含源表中本就未进入本站曲库的曲目。</p><div class="table-scroll" tabindex="0" aria-label="未匹配原始条目表，可横向滚动"><table><thead><tr><th>池</th><th>阶段</th><th>原始条目名 / 标识</th><th>未匹配原因 / 状态</th></tr></thead><tbody>{unmatched.map(item=><tr><td>{item.pool}</td><td>Phase {item.phase}</td><td>{item.title}</td><td>{item.reason}（{sourceLabel(item.source)}）</td></tr>)}</tbody></table></div></section></Layout>
<style>.overview{margin-bottom:var(--w-s-5)}h2,h3{font-family:var(--w-font-display)}h2{margin-top:0}.overview dl{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--w-s-4)}.overview dl div{padding:var(--w-s-3);border:1px solid var(--w-seam);border-radius:var(--w-r-sm);background:var(--w-panel-2)}dt{font-weight:700;color:var(--w-ink-soft)}dd{margin:var(--w-s-1) 0;font:800 var(--w-fs-2xl) var(--w-font-data);color:var(--w-hit-deep)}small,.source{color:var(--w-muted);font-size:var(--w-fs-sm)}.source{margin-bottom:0}.pools{display:grid;gap:var(--w-s-5)}.pools>*{min-width:0}.pool-counts{position:relative;margin:var(--w-s-2) 0;padding:var(--w-s-2);border-left:3px solid var(--w-pool-color);background:var(--w-panel-2);font-size:var(--w-fs-sm)}h3 small{font:var(--w-fs-sm) var(--w-font-data);color:var(--w-muted)}.columns{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:var(--w-s-6);padding-right:var(--w-s-10)}ol{padding-left:var(--w-s-5)}li{margin:var(--w-s-1) 0}em{color:var(--w-muted);font-size:var(--w-fs-xs);font-style:normal}.phase-detail{margin-top:var(--w-s-3);font-size:var(--w-fs-sm)}.phase-detail summary{cursor:pointer;font-weight:700}.unmatched{margin-top:var(--w-s-5)}.table-scroll{overflow-x:auto}table{width:100%;min-width:700px;border-collapse:collapse}th,td{padding:var(--w-s-2);border-bottom:1px solid var(--w-seam);text-align:left;vertical-align:top}@media(max-width:700px){.overview dl,.columns{grid-template-columns:1fr}.columns{padding-right:0}}</style>