---
import Layout from '../components/Layout.astro'; import PageIntro from '../components/PageIntro.astro'; import { jubility, songHref, display } from '../lib/data';
const entries = [...jubility.entries].sort((a,b) => b.constant-a.constant || a.title.localeCompare(b.title));
---
<Layout title="Jubility 理论值" description="国服 Jubility 理论值参考表，按定数排序并链接至收录曲目。" section="data"><PageIntro eyebrow={`DATA / ${jubility.updatedAt}`} title="Jubility 理论值" lead="非官方参考表。理论值按提供表格原样展示；缺失值以破折号标记，曲名可进入本站曲目资料。"/><p class="notice">来源：{jubility.source}</p><div class="table-wrap"><table><thead><tr><th>曲目 / 难度</th><th>定数</th><th>通常</th><th>HARD</th><th>EXC</th><th>分类</th></tr></thead><tbody>{entries.map(e => <tr><td>{e.songId ? <a href={songHref(e.songId)}>{e.title}</a> : e.title}<small>{e.diff}{e.hasAltChart ? ' · 含异谱' : ''}</small></td><td>{e.constant.toFixed(1)}</td><td>{display(e.valueNormal)}</td><td>{display(e.valueHard)}</td><td>{display(e.excClass)}</td><td>{e.section}</td></tr>)}</tbody></table></div></Layout>
<style>.notice{padding:var(--w-s-3);border-left:4px solid var(--w-candy-glint);background:var(--w-candy-glint-soft);color:var(--w-ink-soft)}.table-wrap{overflow-x:auto;border:1px solid var(--w-seam);border-radius:var(--w-r-md);background:var(--w-panel)}table{width:100%;border-collapse:collapse;text-align:left}th,td{padding:var(--w-s-3);border-bottom:1px solid var(--w-seam);white-space:nowrap}th{background:var(--w-panel-2);font-size:var(--w-fs-sm)}td:first-child{white-space:normal;font-weight:700}td small{display:block;color:var(--w-muted);font-weight:400}</style>