---
import Layout from '../components/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import { jubility, songHref, display } from '../lib/data';
const entries = [...jubility.entries].sort((a, b) => b.constant - a.constant || a.title.localeCompare(b.title));
const withAlt = entries.filter(entry => entry.hasAltChart).length;
const unresolved = entries.filter(entry => !entry.songId).length;
const summary = [
  ['条目数', entries.length],
  ['最高定数', Math.max(...entries.map(entry => entry.constant)).toFixed(1)],
  ['含异谱', withAlt],
  ['未链接曲目', unresolved],
];
---
<Layout title="Jubility 理论值" description="国服 Jubility 理论值参考表，按定数排序并链接至收录曲目。" section="data">
  <PageIntro eyebrow={`DATA / ${jubility.updatedAt}`} title="Jubility 理论值" lead="非官方参考表。理论值按提供表格原样展示；缺失值以破折号标记，曲名可进入本站曲目资料。"/>

  <section class="w-panel" aria-labelledby="summary-title">
    <h2 class="wp-h2" id="summary-title">概览<span class="wp-h2__note">按定数倒序排列</span></h2>
    <div class="wp-grid wp-grid--4">
      {summary.map(([label, value]) => <div class="wp-stat"><strong>{value}</strong><span>{label}</span></div>)}
    </div>
    <p class="wp-notice source">来源：{jubility.source}</p>
  </section>

  <section class="wp-section" aria-labelledby="table-title">
    <h2 class="wp-h2" id="table-title">理论值表<span class="wp-h2__note">共 {entries.length} 条</span></h2>
    <div class="wp-table-wrap" tabindex="0" aria-label="Jubility 理论值表，可横向滚动">
      <table class="wp-table">
        <thead><tr>
          <th scope="col">曲目 / 难度</th>
          <th scope="col">定数</th>
          <th scope="col">通常</th>
          <th scope="col">HARD</th>
          <th scope="col">EXC</th>
          <th scope="col">分类</th>
        </tr></thead>
        <tbody>{entries.map(entry => <tr>
          <th scope="row" class="cell-song">
            {entry.songId ? <a href={songHref(entry.songId)}>{entry.title}</a> : <span>{entry.title}</span>}
            <small>{entry.diff}{entry.hasAltChart ? ' · 含异谱' : ''}{!entry.songId ? ' · 未链接曲目' : ''}</small>
          </th>
          <td class="num">{entry.constant.toFixed(1)}</td>
          <td>{display(entry.valueNormal)}</td>
          <td>{display(entry.valueHard)}</td>
          <td>{display(entry.excClass)}</td>
          <td>{entry.section}</td>
        </tr>)}</tbody>
      </table>
    </div>
  </section>
</Layout>
<style>
.source{margin:var(--w-s-4) 0 0}
.cell-song{font-weight:700;white-space:normal}
.cell-song a{color:var(--w-ink);text-decoration:none}
.cell-song a:hover{color:var(--w-hit-deep);text-decoration:underline}
.cell-song small{display:block;color:var(--w-muted);font-size:var(--w-fs-xs);font-weight:400}
</style>
