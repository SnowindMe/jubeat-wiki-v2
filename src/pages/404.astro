---
import Layout from '../components/Layout.astro';
const links = [['曲目库', '/songs/'], ['Jubility', '/jubility/'], ['版本沿革', '/versions/'], ['关于本站', '/about/']];
---
<Layout title="页面未找到" description="此地址没有对应的 jubeat 音乐魔方 WIKI 页面。">
  <section class="notfound w-panel">
    <span class="w-brand-logo w-brand-logo--hero" role="img" aria-label="jubeat 音乐魔方"></span>
    <h1 class="notfound__title">这一格还没有点亮。</h1>
    <p class="wp-prose notfound__lead">页面不存在或路径已经变更。不会自动跳转，请选择下一步。</p>
    <form class="notfound__search" action="/songs/">
      <label for="missing-search">搜索曲目</label>
      <div class="notfound__row">
        <input id="missing-search" class="w-field" name="q" placeholder="输入曲名或 artist"/>
        <button class="wp-btn wp-btn--solid" type="submit">前往曲目库</button>
      </div>
    </form>
    <nav aria-label="404 快捷入口">
      <div class="wp-pills notfound__links">
        {links.map(([label, href]) => <a class="wp-btn" href={href}>{label}</a>)}
      </div>
    </nav>
  </section>
</Layout>
<style>
.notfound{display:grid;justify-items:center;gap:var(--w-s-4);max-width:720px;margin:var(--w-s-10) auto;text-align:center}
.notfound__title{margin:0;color:var(--w-ink);font-family:var(--w-font-display);font-size:var(--w-fs-h1);font-weight:800;line-height:var(--w-lh-tight)}
.notfound__lead{max-width:52ch}
.notfound__search{display:grid;gap:var(--w-s-2);width:min(100%,460px);text-align:left}
.notfound__search label{color:var(--w-ink);font-size:var(--w-fs-sm);font-weight:700}
.notfound__row{display:grid;grid-template-columns:1fr auto;gap:var(--w-s-2)}
.notfound__links{justify-content:center}
@media(max-width:520px){
  .notfound__row{grid-template-columns:1fr}
}
</style>
